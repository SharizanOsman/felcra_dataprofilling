@page "/farms"
@attribute [Authorize(Roles = $"{Roles.HqAdmin},{Roles.FarmManager}")]
@inherits AdminPageBase

<PageHeader Title="@T("Farms")" Subtitle="@T("Farms and premises in the breeding programme")" Error="@LoadError">
    <Actions>
        @if (IsHq)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">@T("Add farm")</MudButton>
        }
    </Actions>
</PageHeader>

<MudPaper Class="pa-4 mb-4" Elevation="1" data-testid="farm-map">
    @if (IsHq)
    {
        <FarmMap Farms="_mapPoints" OnAddHere="AddAtAsync" />
    }
    else
    {
        <FarmMap Farms="_mapPoints" />
    }
</MudPaper>

<MudTable Items="_farms" Hover="true" Loading="IsLoading" Elevation="1" Breakpoint="Breakpoint.Sm">
    <HeaderContent>
        <MudTh>@T("Code")</MudTh>
        <MudTh>@T("Name")</MudTh>
        <MudTh>@T("State")</MudTh>
        <MudTh Style="text-align:right">@T("Area (ha)")</MudTh>
        <MudTh Style="text-align:right">@T("Capacity")</MudTh>
        <MudTh>@T("Projects")</MudTh>
        <MudTh>@T("Status")</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T("Code")">@context.Code</MudTd>
        <MudTd DataLabel="@T("Name")"><MudLink Href="@($"farms/{context.Id}")">@context.Name</MudLink></MudTd>
        <MudTd DataLabel="@T("State")">@context.State</MudTd>
        <MudTd DataLabel="@T("Area (ha)")" Style="text-align:right">@context.AreaHectares?.ToString("N1")</MudTd>
        <MudTd DataLabel="@T("Capacity")" Style="text-align:right">@context.Capacity</MudTd>
        <MudTd DataLabel="@T("Projects")">@string.Join(", ", context.ProjectIds.Select(ProjectCode))</MudTd>
        <MudTd DataLabel="@T("Status")"><StatusChip Active="context.IsActive" /></MudTd>
        <MudTd Style="text-align:right">
            @if (IsHq)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditAsync(context)" aria-label="@T("Edit")" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context)" aria-label="@T("Delete")" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>@T("No farms yet.")</MudText></NoRecordsContent>
</MudTable>

@code {
    private List<FarmDto> _farms = [];
    private List<ProjectDto> _projects = [];
    private List<FarmMapPointDto> _mapPoints = [];
    private static readonly Func<object, string, Task<IEnumerable<string>>> Validate = FormValidation.For(new FarmRequestValidator());

    protected override async Task LoadAsync()
    {
        _projects = await Api.GetAsync<List<ProjectDto>>("api/projects");
        _farms = await Api.GetAsync<List<FarmDto>>("api/farms");
        _mapPoints = await Api.GetAsync<List<FarmMapPointDto>>("api/farms/map");
    }

    private string ProjectCode(Guid id) => _projects.FirstOrDefault(p => p.Id == id)?.Code ?? "?";

    private Task AddAsync() => AddAtAsync(null);

    /// <summary>New farm, placed at a spot found on the map when there is one.</summary>
    private async Task AddAtAsync(PlaceResult? place) =>
        await AfterSaveAsync(
            await Dialogs.EditAsync(T("Add farm"), new FarmRequest { Latitude = place?.Latitude, Longitude = place?.Longitude, State = place?.State }, FarmFields,
                m => Api.PostAsync<FarmDto>("api/farms", m), Validate),
            T("Farm added."));

    private async Task EditAsync(FarmDto farm) =>
        await AfterSaveAsync(
            await Dialogs.EditAsync(T("Edit {0}", farm.Name), FarmRequest.From(farm), FarmFields,
                m => Api.PutAsync<FarmDto>($"api/farms/{farm.Id}", m), Validate),
            T("Farm updated."));

    private async Task DeleteAsync(FarmDto farm)
    {
        if (await Dialogs.ConfirmDeleteAsync(T("farm {0}", farm.Name)))
            await NotifyAsync(await Api.DeleteAsync($"api/farms/{farm.Id}"), T("Farm deleted."));
    }

    private RenderFragment<FarmRequest> FarmFields => m =>
        @<MudStack Spacing="2">
            <MudTextField @bind-Value="m.Code" For="@(() => m.Code)" Label="@T("Code")" HelperText="@T("Short unique code, e.g. PAGOH")" />
            <MudTextField @bind-Value="m.Name" For="@(() => m.Name)" Label="@T("Name")" />
            <MudTextField @bind-Value="m.Address" For="@(() => m.Address)" Label="@T("Address")" Lines="2" />
            <LocationPicker Model="m" />
            <MudStack Row="true">
                <MudNumericField @bind-Value="m.AreaHectares" For="@(() => m.AreaHectares)" Label="@T("Area (ha)")" />
                <MudNumericField @bind-Value="m.Capacity" For="@(() => m.Capacity)" Label="@T("Capacity (head)")" />
            </MudStack>
            <MudSelect T="Guid" Label="@T("Projects / schemes")" MultiSelection="true"
                       SelectedValues="m.ProjectIds" SelectedValuesChanged="@(v => m.ProjectIds = v.ToList())"
                       ToStringFunc="ProjectCode">
                @foreach (var p in _projects.Where(p => p.IsActive || m.ProjectIds.Contains(p.Id)))
                {
                    <MudSelectItem Value="p.Id">@p.Code — @p.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSwitch @bind-Value="m.IsActive" Label="@T("Active")" Color="Color.Primary" />
        </MudStack>;
}
