@page "/farms/{Id:guid}"
@attribute [Authorize(Roles = $"{Roles.HqAdmin},{Roles.FarmManager}")]
@inherits AdminPageBase

<MudBreadcrumbs Items="_breadcrumbs" Class="px-0 pt-0" />

<PageHeader Title="@(_farm?.Name ?? T("Farm"))" Subtitle="@_farm?.Code" Error="@LoadError" />

@if (_farm is not null)
{
    <MudGrid>
        <MudItem xs="12" md="4">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" GutterBottom="true">@T("Details")</MudText>
                <MudSimpleTable Dense="true" Elevation="0">
                    <tbody>
                        <tr><td>@T("Address")</td><td>@_farm.Address</td></tr>
                        <tr><td>@T("State")</td><td>@_farm.State</td></tr>
                        <tr><td>@T("Area")</td><td>@(_farm.AreaHectares is { } area ? $"{area:N1} ha" : "")</td></tr>
                        <tr>
                            <td>@T("Location")</td>
                            <td>
                                @if (_farm.Latitude is { } lat && _farm.Longitude is { } lon)
                                {
                                    var coords = FormattableString.Invariant($"{lat:0.######},{lon:0.######}");
                                    <span>@coords</span>
                                    <MudLink Href="@FarmMap.GoogleMaps(lat, lon)" Target="_blank" Class="ml-2">@T("Open in Google Maps")</MudLink>
                                }
                                else
                                {
                                    <span>@T("Not set")</span>
                                }
                            </td>
                        </tr>
                        <tr><td>@T("Capacity")</td><td>@(_farm.Capacity is { } capacity ? T("{0} head", capacity) : "")</td></tr>
                        <tr><td>@T("Projects")</td><td>@string.Join(", ", _farm.ProjectIds.Select(id => _projects.FirstOrDefault(p => p.Id == id)?.Code))</td></tr>
                        <tr><td>@T("Status")</td><td><StatusChip Active="_farm.IsActive" /></td></tr>
                    </tbody>
                </MudSimpleTable>
                @if (_farm.Latitude is not null && _farm.Longitude is not null)
                {
                    <div class="mt-3"><FarmLocationMap Farm="_farm" /></div>
                }

            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="8">
            <MudPaper Class="pa-4" Elevation="1">
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-2">
                    <MudText Typo="Typo.h6">@T("Herd groups / pens")</MudText>
                    <MudSpacer />
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddGroupAsync">@T("Add group")</MudButton>
                </MudStack>
                <MudTable Items="_groups" Dense="true" Hover="true" Elevation="0" Loading="IsLoading">
                    <HeaderContent>
                        <MudTh>@T("Name")</MudTh>
                        <MudTh>@T("Description")</MudTh>
                        <MudTh>@T("Status")</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="@T("Name")">@context.Name</MudTd>
                        <MudTd DataLabel="@T("Description")">@context.Description</MudTd>
                        <MudTd DataLabel="@T("Status")"><StatusChip Active="context.IsActive" /></MudTd>
                        <MudTd Style="text-align:right">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditGroupAsync(context)" aria-label="@T("Edit")" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteGroupAsync(context)" aria-label="@T("Delete")" />
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent><MudText>@T("No groups yet.")</MudText></NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudItem>
    </MudGrid>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private FarmDto? _farm;
    private List<ProjectDto> _projects = [];
    private List<HerdGroupDto> _groups = [];
    private List<BreadcrumbItem> _breadcrumbs = [];
    private static readonly Func<object, string, Task<IEnumerable<string>>> Validate = FormValidation.For(new HerdGroupRequestValidator());

    private string GroupsUrl => $"api/farms/{Id}/groups";

    protected override async Task LoadAsync()
    {
        _farm = await Api.GetAsync<FarmDto>($"api/farms/{Id}");
        _projects = await Api.GetAsync<List<ProjectDto>>("api/projects");
        _groups = await Api.GetAsync<List<HerdGroupDto>>(GroupsUrl);
        _breadcrumbs = [new(T("Farms"), "farms"), new(_farm.Name, null, disabled: true)];
    }

    private async Task AddGroupAsync() =>
        await AfterSaveAsync(
            await Dialogs.EditAsync(T("Add group"), new HerdGroupRequest(), GroupFields,
                m => Api.PostAsync<HerdGroupDto>(GroupsUrl, m), Validate),
            T("Group added."));

    private async Task EditGroupAsync(HerdGroupDto group) =>
        await AfterSaveAsync(
            await Dialogs.EditAsync(T("Edit {0}", group.Name), HerdGroupRequest.From(group), GroupFields,
                m => Api.PutAsync<HerdGroupDto>($"{GroupsUrl}/{group.Id}", m), Validate),
            T("Group updated."));

    private async Task DeleteGroupAsync(HerdGroupDto group)
    {
        if (await Dialogs.ConfirmDeleteAsync(T("group {0}", group.Name)))
            await NotifyAsync(await Api.DeleteAsync($"{GroupsUrl}/{group.Id}"), T("Group deleted."));
    }

    private RenderFragment<HerdGroupRequest> GroupFields => m =>
        @<MudStack Spacing="2">
            <MudTextField @bind-Value="m.Name" For="@(() => m.Name)" Label="@T("Name")" HelperText="@T("e.g. Pen A, Breeding herd, Weaners")" />
            <MudTextField @bind-Value="m.Description" For="@(() => m.Description)" Label="@T("Description")" Lines="2" />
            <MudSwitch @bind-Value="m.IsActive" Label="@T("Active")" Color="Color.Primary" />
        </MudStack>;
}
