@page "/master-data/breeds"
@attribute [Authorize(Roles = $"{Roles.HqAdmin},{Roles.FarmManager}")]
@inherits AdminPageBase

<PageHeader Title="@T("Breeds")" Error="@LoadError">
    <Actions>
        @if (IsHq)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">@T("Add breed")</MudButton>
        }
    </Actions>
</PageHeader>

<MudTable Items="_items" Hover="true" Loading="IsLoading" Elevation="1" Breakpoint="Breakpoint.Sm">
    <HeaderContent>
        <MudTh>@T("Code")</MudTh>
        <MudTh>@T("Name")</MudTh>
        <MudTh>@T("Description")</MudTh>
        <MudTh>@T("Status")</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T("Code")">@context.Code</MudTd>
        <MudTd DataLabel="@T("Name")">@context.Name</MudTd>
        <MudTd DataLabel="@T("Description")">@context.Description</MudTd>
        <MudTd DataLabel="@T("Status")"><StatusChip Active="context.IsActive" /></MudTd>
        <MudTd Style="text-align:right">
            @if (IsHq)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditAsync(context)" aria-label="@T("Edit")" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context)" aria-label="@T("Delete")" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>@T("No breeds yet.")</MudText></NoRecordsContent>
</MudTable>

@code {
    private const string Url = "api/breeds";
    private List<BreedDto> _items = [];
    private static readonly Func<object, string, Task<IEnumerable<string>>> Validate = FormValidation.For(new BreedRequestValidator());

    protected override async Task LoadAsync() => _items = await Api.GetAsync<List<BreedDto>>(Url);

    private async Task AddAsync() =>
        await AfterSaveAsync(await Dialogs.EditAsync(T("Add breed"), new BreedRequest(), Fields,
            m => Api.PostAsync<BreedDto>(Url, m), Validate), T("Breed added."));

    private async Task EditAsync(BreedDto item) =>
        await AfterSaveAsync(await Dialogs.EditAsync(T("Edit {0}", item.Name), BreedRequest.From(item), Fields,
            m => Api.PutAsync<BreedDto>($"{Url}/{item.Id}", m), Validate), T("Breed updated."));

    private async Task DeleteAsync(BreedDto item)
    {
        if (await Dialogs.ConfirmDeleteAsync(T("breed {0}", item.Name)))
            await NotifyAsync(await Api.DeleteAsync($"{Url}/{item.Id}"), T("Breed deleted."));
    }

    private RenderFragment<BreedRequest> Fields => m =>
        @<MudStack Spacing="2">
            <MudTextField @bind-Value="m.Code" For="@(() => m.Code)" Label="@T("Code")" HelperText="@T("e.g. BX")" />
            <MudTextField @bind-Value="m.Name" For="@(() => m.Name)" Label="@T("Name")" HelperText="@T("e.g. Brahman Cross")" />
            <MudTextField @bind-Value="m.Description" For="@(() => m.Description)" Label="@T("Description")" Lines="3" />
            <MudSwitch @bind-Value="m.IsActive" Label="@T("Active")" Color="Color.Primary" />
        </MudStack>;
}
