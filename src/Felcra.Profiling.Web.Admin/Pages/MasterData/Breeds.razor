@page "/master-data/breeds"
@attribute [Authorize(Roles = $"{Roles.HqAdmin},{Roles.FarmManager}")]
@inherits AdminPageBase

<PageHeader Title="Breeds" Error="@LoadError">
    <Actions>
        @if (IsHq)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">Add breed</MudButton>
        }
    </Actions>
</PageHeader>

<MudTable Items="_items" Hover="true" Loading="IsLoading" Elevation="1" Breakpoint="Breakpoint.Sm">
    <HeaderContent>
        <MudTh>Code</MudTh>
        <MudTh>Name</MudTh>
        <MudTh>Description</MudTh>
        <MudTh>Status</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Code">@context.Code</MudTd>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Description">@context.Description</MudTd>
        <MudTd DataLabel="Status"><StatusChip Active="context.IsActive" /></MudTd>
        <MudTd Style="text-align:right">
            @if (IsHq)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditAsync(context)" aria-label="Edit" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context)" aria-label="Delete" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>No breeds yet.</MudText></NoRecordsContent>
</MudTable>

@code {
    private const string Url = "api/breeds";
    private List<BreedDto> _items = [];
    private static readonly Func<object, string, Task<IEnumerable<string>>> Validate = FormValidation.For(new BreedRequestValidator());

    protected override async Task LoadAsync() => _items = await Api.GetAsync<List<BreedDto>>(Url);

    private async Task AddAsync() =>
        await AfterSaveAsync(await Dialogs.EditAsync("Add breed", new BreedRequest(), Fields,
            m => Api.PostAsync<BreedDto>(Url, m), Validate), "Breed added.");

    private async Task EditAsync(BreedDto item) =>
        await AfterSaveAsync(await Dialogs.EditAsync($"Edit {item.Name}", BreedRequest.From(item), Fields,
            m => Api.PutAsync<BreedDto>($"{Url}/{item.Id}", m), Validate), "Breed updated.");

    private async Task DeleteAsync(BreedDto item)
    {
        if (await Dialogs.ConfirmDeleteAsync($"breed {item.Name}"))
            await NotifyAsync(await Api.DeleteAsync($"{Url}/{item.Id}"), "Breed deleted.");
    }

    private RenderFragment<BreedRequest> Fields => m =>
        @<MudStack Spacing="2">
            <MudTextField @bind-Value="m.Code" For="@(() => m.Code)" Label="Code" HelperText="e.g. BX" />
            <MudTextField @bind-Value="m.Name" For="@(() => m.Name)" Label="Name" HelperText="e.g. Brahman Cross" />
            <MudTextField @bind-Value="m.Description" For="@(() => m.Description)" Label="Description" Lines="3" />
            <MudSwitch @bind-Value="m.IsActive" Label="Active" Color="Color.Primary" />
        </MudStack>;
}
