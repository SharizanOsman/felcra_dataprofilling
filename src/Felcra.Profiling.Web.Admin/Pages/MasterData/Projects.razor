@page "/master-data/projects"
@attribute [Authorize(Roles = $"{Roles.HqAdmin},{Roles.FarmManager}")]
@inherits AdminPageBase

<PageHeader Title="@T("Projects & schemes")" Subtitle="@T("Funding projects such as EPP5 and RP4")" Error="@LoadError">
    <Actions>
        @if (IsHq)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync">@T("Add project")</MudButton>
        }
    </Actions>
</PageHeader>

<MudTable Items="_items" Hover="true" Loading="IsLoading" Elevation="1" Breakpoint="Breakpoint.Sm">
    <HeaderContent>
        <MudTh>@T("Code")</MudTh>
        <MudTh>@T("Name")</MudTh>
        <MudTh>@T("Plan")</MudTh>
        <MudTh>@T("Description")</MudTh>
        <MudTh>@T("Status")</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T("Code")">@context.Code</MudTd>
        <MudTd DataLabel="@T("Name")">@context.Name</MudTd>
        <MudTd DataLabel="@T("Plan")">@context.PlanReference</MudTd>
        <MudTd DataLabel="@T("Description")">@context.Description</MudTd>
        <MudTd DataLabel="@T("Status")"><StatusChip Active="context.IsActive" /></MudTd>
        <MudTd Style="text-align:right">
            @if (IsHq)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="() => EditAsync(context)" aria-label="@T("Edit")" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="() => DeleteAsync(context)" aria-label="@T("Delete")" />
            }
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>@T("No projects yet.")</MudText></NoRecordsContent>
</MudTable>

@code {
    private const string Url = "api/projects";
    private List<ProjectDto> _items = [];
    private static readonly Func<object, string, Task<IEnumerable<string>>> Validate = FormValidation.For(new ProjectRequestValidator());

    protected override async Task LoadAsync() => _items = await Api.GetAsync<List<ProjectDto>>(Url);

    private async Task AddAsync() =>
        await AfterSaveAsync(await Dialogs.EditAsync(T("Add project"), new ProjectRequest(), Fields,
            m => Api.PostAsync<ProjectDto>(Url, m), Validate), T("Project added."));

    private async Task EditAsync(ProjectDto item) =>
        await AfterSaveAsync(await Dialogs.EditAsync(T("Edit {0}", item.Code), ProjectRequest.From(item), Fields,
            m => Api.PutAsync<ProjectDto>($"{Url}/{item.Id}", m), Validate), T("Project updated."));

    private async Task DeleteAsync(ProjectDto item)
    {
        if (await Dialogs.ConfirmDeleteAsync(T("project {0}", item.Code)))
            await NotifyAsync(await Api.DeleteAsync($"{Url}/{item.Id}"), T("Project deleted."));
    }

    private RenderFragment<ProjectRequest> Fields => m =>
        @<MudStack Spacing="2">
            <MudTextField @bind-Value="m.Code" For="@(() => m.Code)" Label="@T("Code")" HelperText="@T("e.g. EPP5")" />
            <MudTextField @bind-Value="m.Name" For="@(() => m.Name)" Label="@T("Name")" />
            <MudTextField @bind-Value="m.PlanReference" For="@(() => m.PlanReference)" Label="@T("Plan reference")" HelperText="@T("e.g. RMK-11")" />
            <MudTextField @bind-Value="m.Description" For="@(() => m.Description)" Label="@T("Description")" Lines="3" />
            <MudSwitch @bind-Value="m.IsActive" Label="@T("Active")" Color="Color.Primary" />
        </MudStack>;
}
