@page "/census"
@attribute [Authorize(Roles = $"{Roles.HqAdmin},{Roles.FarmManager}")]
@inherits AdminPageBase
@inject NavigationManager Navigation

<PageHeader Title="@T("Census sessions")" Subtitle="@T("Headcount, profiling and health programmes")" Error="@LoadError">
    <Actions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddAsync" Disabled="_lookups is null">@T("New session")</MudButton>
    </Actions>
</PageHeader>

<MudTable T="CensusSessionDto" Items="_sessions" Hover="true" Loading="IsLoading" Elevation="1" Breakpoint="Breakpoint.Sm"
          OnRowClick="@(e => Navigation.NavigateTo($"census/{e.Item!.Id}"))" RowStyle="cursor:pointer">
    <HeaderContent>
        <MudTh>@T("Session")</MudTh>
        <MudTh>@T("Farm")</MudTh>
        <MudTh>@T("Dates")</MudTh>
        <MudTh Style="text-align:right">@T("On record")</MudTh>
        <MudTh Style="text-align:right">@T("Counted")</MudTh>
        <MudTh Style="text-align:right">@T("Selected")</MudTh>
        <MudTh>@T("Status")</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T("Session")">@context.Title</MudTd>
        <MudTd DataLabel="@T("Farm")">@context.FarmCode</MudTd>
        <MudTd DataLabel="@T("Dates")">@context.StartDate.ToString("dd MMM yyyy") – @context.EndDate.ToString("dd MMM yyyy")</MudTd>
        <MudTd DataLabel="@T("On record")" Style="text-align:right">@RecordedTotal(context)</MudTd>
        <MudTd DataLabel="@T("Counted")" Style="text-align:right">@context.Counted.Total</MudTd>
        <MudTd DataLabel="@T("Selected")" Style="text-align:right">@context.SelectedCount</MudTd>
        <MudTd DataLabel="@T("Status")">
            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="@(context.IsClosed ? Color.Default : Color.Success)">@(context.IsClosed ? T("Closed") : T("In progress"))</MudChip>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>@T("No census sessions yet.")</MudText></NoRecordsContent>
</MudTable>

@code {
    private List<CensusSessionDto> _sessions = [];
    private Lookups? _lookups;
    private static readonly Func<object, string, Task<IEnumerable<string>>> Validate = FormValidation.For(new CensusSessionRequestValidator());

    protected override async Task LoadAsync()
    {
        _lookups ??= await Lookups.LoadAsync(Api);
        _sessions = await Api.GetAsync<List<CensusSessionDto>>("api/census-sessions");
    }

    internal static string RecordedTotal(CensusSessionDto s) =>
        s.RecordedBulls is null && s.RecordedDams is null && s.RecordedMaleCalves is null && s.RecordedFemaleCalves is null
            ? "–"
            : ((s.RecordedBulls ?? 0) + (s.RecordedDams ?? 0) + (s.RecordedMaleCalves ?? 0) + (s.RecordedFemaleCalves ?? 0)).ToString();

    private async Task AddAsync()
    {
        var model = new CensusSessionRequest { FarmId = _lookups!.Farms.FirstOrDefault(f => f.IsActive)?.Id ?? Guid.Empty };
        CensusSessionDto? created = null;
        var saved = await Dialogs.EditAsync(T("New census session"), model,

            m => @<CensusSessionFields Model="m" Lookups="_lookups!" IsNew="true" />,
            async m =>
            {
                var result = await Api.PostAsync<CensusSessionDto>("api/census-sessions", m);
                created = result.Value;
                return result;
            }, Validate);
        if (saved && created is not null) Navigation.NavigateTo($"census/{created.Id}");
    }
}
