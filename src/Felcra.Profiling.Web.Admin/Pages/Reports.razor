@page "/reports"
@attribute [Authorize(Roles = $"{Roles.HqAdmin},{Roles.FarmManager}")]
@inherits AdminPageBase
@using Felcra.Profiling.Contracts.Reports

<PageHeader Title="Reports" Subtitle="PDF for printing and sharing, Excel for further analysis" Error="@LoadError">
    <Actions>
        <FarmFilter Farms="_farms" Value="_farmId" ValueChanged="OnFarmChanged" />
    </Actions>
</PageHeader>

<MudPaper Class="pa-3 mb-4" Elevation="1">
    <MudStack Row="true" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Spacing="3">
        <MudText Typo="Typo.subtitle1">Period</MudText>
        <div style="width:170px"><DateField Label="From" Value="_from" ValueChanged="@(d => SetPeriod(d ?? _from, _to))" Clearable="false" /></div>
        <div style="width:170px"><DateField Label="To" Value="_to" ValueChanged="@(d => SetPeriod(_from, d ?? _to))" Clearable="false" /></div>
        <MudChipSet T="string" SelectionMode="SelectionMode.SingleSelection" SelectedValue="_preset" SelectedValueChanged="ApplyPreset" Size="Size.Small"
                     SelectedColor="Color.Primary" CheckMark="true">
            <MudChip T="string" Value="@("last-month")">Last month</MudChip>
            <MudChip T="string" Value="@("this-month")">This month</MudChip>
            <MudChip T="string" Value="@("last-3")">Last 3 months</MudChip>
            <MudChip T="string" Value="@("this-year")">This year</MudChip>
        </MudChipSet>
    </MudStack>
    @if (_to < _from)
    {
        <MudText Typo="Typo.caption" Color="Color.Error">The end date must be on or after the start date.</MudText>
    }
</MudPaper>

<MudGrid Spacing="3">
    <MudItem xs="12" md="6">
        <ReportCard Title="Farm performance" Icon="@Icons.Material.Filled.Insights"
                    Description="Herd by category, records made in the period, animals that left the herd, breeding, growth and data quality.">
            <ReportButtons Name="Farm performance" Href="@($"api/reports/performance?{FarmAnd}from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}")"
                           Download="DownloadAsync" Busy="@BusyOrInvalid" />
        </ReportCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <ReportCard Title="Health and treatments" Icon="@Icons.Material.Filled.Vaccines"
                    Description="Every treatment given in the period with dose, batch and withdrawal date, and a summary by product.">
            <ReportButtons Name="Health and treatments" Href="@($"api/reports/treatments?{FarmAnd}from={_from:yyyy-MM-dd}&to={_to:yyyy-MM-dd}")"
                           Download="DownloadAsync" Busy="@BusyOrInvalid" />
        </ReportCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <ReportCard Title="Culling candidates" Icon="@Icons.Material.Filled.ContentCut"
                    Description="Animals meeting the age, fertility or body-condition rules today (the period does not apply).">
            <ReportButtons Name="Culling candidates" Href="@($"api/reports/culling-candidates{FarmFilter.Query(_farmId)}")" Download="DownloadAsync" Busy="@Downloading" />
        </ReportCard>
    </MudItem>
    <MudItem xs="12" md="6">
        <ReportCard Title="Census and profiling form" Icon="@Icons.Material.Filled.FactCheck"
                    Description="The census programme in the layout of the Pagoh report, and the list of selected animals.">
            <MudSelect T="Guid?" @bind-Value="_sessionId" Label="Census programme" Dense="true" Class="mb-2"
                       ToStringFunc="@(id => Sessions.FirstOrDefault(s => s.Id == id) is { } s ? SessionLabel(s) : "")">
                @foreach (var s in Sessions)
                {
                    <MudSelectItem T="Guid?" Value="@s.Id">@SessionLabel(s)</MudSelectItem>
                }
            </MudSelect>
            @if (_sessionId is { } id)
            {
                <MudStack Spacing="1">
                    <MudText Typo="Typo.caption">Census and profiling form</MudText>
                    <ReportButtons Name="Census and profiling form" Href="@($"api/reports/census-sessions/{id}/form")" Download="DownloadAsync" Busy="@Downloading" />
                    <MudText Typo="Typo.caption" Class="mt-2">Selected animals</MudText>
                    <ReportButtons Name="Selected animals" Href="@($"api/reports/census-sessions/{id}/selected")" Download="DownloadAsync" Busy="@Downloading" />
                </MudStack>
            }
            else if (Sessions.Count == 0 && !IsLoading)
            {
                <MudText Typo="Typo.body2">No census programmes for this farm yet.</MudText>
            }
        </ReportCard>
    </MudItem>
</MudGrid>

@if (IsHq && _monthly is { } m)
{
    <MudText Typo="Typo.h6" Class="mt-6 mb-2">Monthly report e-mail</MudText>
    <MudPaper Class="pa-4" Elevation="1">
        <MudGrid Spacing="3">
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.body2" Class="mb-2">
                    On day @m.DayOfMonth of each month from @($"{m.Hour:00}:00") (Malaysia time), last month's farm performance, health and
                    treatment, and culling candidate reports are e-mailed as PDFs: HQ admins get all farms, each farm manager gets their own farms.
                </MudText>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mb-3">
                    <MudChip T="string" Size="Size.Small" Color="@(m.Enabled ? Color.Success : Color.Default)" Variant="Variant.Outlined">
                        @(m.Enabled ? "Schedule on" : "Schedule off")
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Color="@(m.EmailConfigured ? Color.Success : Color.Warning)" Variant="Variant.Outlined">
                        @(m.EmailConfigured ? "E-mail configured" : "E-mail not configured")
                    </MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">@m.Recipients recipients</MudChip>
                </MudStack>
                @if (!m.Enabled || !m.EmailConfigured)
                {
                    <MudText Typo="Typo.caption" Style="display:block" Class="mb-2">
                        Set up by the server administrator: <code>Reports:Monthly:Enabled</code> and the <code>Email</code> settings (SMTP server and sender).
                    </MudText>
                }
                <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Send" Disabled="@(!m.EmailConfigured || _sendingTest)"
                           OnClick="SendTestAsync">Send me a test e-mail</MudButton>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSimpleTable Dense="true" Elevation="0">
                    <thead><tr><th>Month</th><th>Sent</th><th style="text-align:right">E-mails</th></tr></thead>
                    <tbody>
                        @foreach (var run in m.RecentRuns)
                        {
                            <tr>
                                <td>@run.Period.ToString("MMMM yyyy")</td>
                                <td>@(run.CompletedAt is { } done ? done.ToLocalTime().ToString("d MMM yyyy HH:mm") : "in progress")</td>
                                <td style="text-align:right">@run.EmailsSent</td>
                            </tr>
                        }
                        @if (m.RecentRuns.Count == 0)
                        {
                            <tr><td colspan="3">Nothing sent yet.</td></tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudItem>
        </MudGrid>
    </MudPaper>
}

@code {
    private List<FarmDto> _farms = [];
    private List<CensusSessionDto> _sessions = [];
    private Guid? _farmId;
    private Guid? _sessionId;
    private DateOnly _from, _to;
    private string? _preset = "last-month";
    private MonthlyReportStatusDto? _monthly;
    private bool _sendingTest;

    private string FarmAnd => _farmId is { } id ? $"farmId={id}&" : "";
    private List<CensusSessionDto> Sessions => _sessions.Where(s => _farmId is null || s.FarmId == _farmId).ToList();
    private string? BusyOrInvalid => _to < _from ? "invalid" : Downloading;

    protected override async Task LoadAsync()
    {
        if (_from == default) ApplyPreset("last-month");
        var farms = Api.GetAsync<List<FarmDto>>("api/farms");
        var sessions = Api.GetAsync<List<CensusSessionDto>>("api/census-sessions");
        (_farms, _sessions) = (await farms, await sessions);
        _sessionId ??= Sessions.FirstOrDefault()?.Id;
        if (IsHq) _monthly = await Api.GetAsync<MonthlyReportStatusDto>("api/reports/monthly");
    }

    private void OnFarmChanged(Guid? farmId)
    {
        _farmId = farmId;
        _sessionId = Sessions.FirstOrDefault()?.Id;
    }

    private void SetPeriod(DateOnly from, DateOnly to)
    {
        (_from, _to) = (from, to);
        _preset = null;
    }

    private void ApplyPreset(string? preset)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        var month = new DateOnly(today.Year, today.Month, 1);
        (_from, _to) = preset switch
        {
            "this-month" => (month, today),
            "last-3" => (month.AddMonths(-3), month.AddDays(-1)),
            "this-year" => (new DateOnly(today.Year, 1, 1), today),
            _ => (month.AddMonths(-1), month.AddDays(-1)),
        };
        _preset = preset ?? "last-month";
    }

    private static string SessionLabel(CensusSessionDto s) => $"{s.FarmCode} · {s.Title} ({s.StartDate:dd MMM yyyy})";

    private async Task SendTestAsync()
    {
        _sendingTest = true;
        try
        {
            var result = await Api.PostAsync<TestEmailResultDto>($"api/reports/monthly/test{FarmFilter.Query(_farmId)}", new { });
            if (result.Value is { } sent)
                Snackbar.Add($"Test e-mail sent to {sent.SentTo} with {sent.Attachments.Count} reports.", Severity.Success);
            else
                Snackbar.Add(result.FullError ?? "The test e-mail could not be sent.", Severity.Error);
        }
        finally
        {
            _sendingTest = false;
        }
    }
}
