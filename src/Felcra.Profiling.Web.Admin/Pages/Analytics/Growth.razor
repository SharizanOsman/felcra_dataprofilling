@page "/analytics/growth"
@attribute [Authorize(Roles = $"{Roles.HqAdmin},{Roles.FarmManager}")]
@inherits AdminPageBase
@inject NavigationManager Navigation
@using Felcra.Profiling.Contracts.Analytics

<PageHeader Title="@T("Growth")" Subtitle="@T("Gompertz growth curves fitted to the herd's weighings")" Error="@LoadError">
    <Actions>
        <FarmFilter Farms="_farms" Value="_farmId" ValueChanged="OnFarmChanged" />
    </Actions>
</PageHeader>

@if (_growth is null)
{
    @if (IsLoading) { <MudProgressLinear Indeterminate="true" /> }
}
else
{
    <MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4" Class="mb-4">
        @foreach (var curve in _growth.Curves)
        {
            <MudTabPanel Text="@(curve.Sex == Sex.Female ? T("Females") : T("Males"))">
                @if (curve.Fit is not { } fit)
                {
                    <MudAlert Severity="Severity.Info">@curve.Message</MudAlert>
                }
                else
                {
                    <MudGrid Spacing="3">
                        <MudItem xs="12" lg="8">
                            <XyChart XLabel="@T("Age (months)")" YLabel="@T("Weight (kg)")" AriaLabel="@T("Growth curve")" Series="@Series(curve)" />
                        </MudItem>
                        <MudItem xs="12" lg="4">
                            <MudSimpleTable Dense="true" Elevation="0">
                                <tbody>
                                    <tr><td>@T("Mature weight (A)")</td><td style="text-align:right" data-testid="mature-weight">@T("{0:0} kg", fit.MatureWeightKg)</td></tr>
                                    <tr><td>@T("Fastest growth at")</td><td style="text-align:right">@AnimalText.Months((int)Math.Round(fit.InflectionAgeDays / 30.44))</td></tr>
                                    <tr><td>@T("Peak daily gain")</td><td style="text-align:right">@T("{0:0.00} kg/day", PeakGain(curve))</td></tr>
                                    <tr><td>@T("Weight at 12 / 24 months")</td><td style="text-align:right">@WeightAt(curve, 12) / @WeightAt(curve, 24) kg</td></tr>
                                    <tr><td>@T("Fit (R²)")</td><td style="text-align:right">@fit.RSquared.ToString("0.00")</td></tr>
                                    <tr><td>@T("Typical error")</td><td style="text-align:right">± @fit.RmseKg.ToString("0") kg</td></tr>
                                    <tr><td>@T("Weighings used")</td><td style="text-align:right">@fit.Points</td></tr>
                                </tbody>
                            </MudSimpleTable>
                            <MudText Typo="Typo.caption" Style="display:block" Class="mt-2">
                                @T("W(t) = A·exp(−b·exp(−k·t)), with b = {0:0.###} and k = {1:0.#####} per day (t in days). The curve gives {2:0} kg at birth; a 30 kg birth weight guides the fit when few young animals are weighed.", fit.B, fit.K, fit.BirthWeightKg)
                            </MudText>
                        </MudItem>
                    </MudGrid>
                }
            </MudTabPanel>
        }
    </MudTabs>

    <MudText Typo="Typo.h6" Class="mb-2">@T("Below the curve ({0})", _growth.BelowCurve.Count)</MudText>
    <MudTable T="GrowthAnimalDto" Items="_growth.BelowCurve" Dense="true" Hover="true" Elevation="1" Breakpoint="Breakpoint.Sm"
              OnRowClick="@(e => Navigation.NavigateTo($"animals/{e.Item!.AnimalId}"))" RowStyle="cursor:pointer">
        <HeaderContent>
            <MudTh>@T("Animal")</MudTh>
            <MudTh>@T("Category")</MudTh>
            <MudTh>@T("Age")</MudTh>
            <MudTh Style="text-align:right">@T("Weight")</MudTh>
            <MudTh Style="text-align:right">@T("Expected")</MudTh>
            <MudTh Style="text-align:right">@T("Difference")</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@T("Animal")">@context.AnimalNo · @(context.TagNumber ?? T("no tag"))</MudTd>
            <MudTd DataLabel="@T("Category")">@AnimalText.Category(context.Category)</MudTd>
            <MudTd DataLabel="@T("Age")">@(context.AgeIsEstimated ? "~" : "")@AnimalText.Months((int)(context.AgeDays / 30.44))</MudTd>
            <MudTd DataLabel="@T("Weight")" Style="text-align:right">@context.WeightKg.ToString("0") kg <MudText Typo="Typo.caption" Style="display:block">@context.WeighedOn.ToString("dd MMM yyyy")</MudText></MudTd>
            <MudTd DataLabel="@T("Expected")" Style="text-align:right">@context.ExpectedKg?.ToString("0") kg</MudTd>
            <MudTd DataLabel="@T("Difference")" Style="text-align:right"><MudText Typo="Typo.body2" Color="Color.Error">@context.DeviationPercent?.ToString("0")%</MudText></MudTd>
        </RowTemplate>
        <NoRecordsContent><MudText>@T("No animal is more than {0}% below the curve.", -_growth.BelowCurveThresholdPercent)</MudText></NoRecordsContent>
    </MudTable>
    <MudText Typo="Typo.caption" Style="display:block" Class="mt-2">
        @T("Each animal's latest weight is compared with the curve for its age; animals {0}% or more below it are listed (calves under 3 months are not judged).", -_growth.BelowCurveThresholdPercent)
        @T("Uses {0} weighings (field and census) of animals with a birth date.", _growth.WeighingsUsed)
        @if (_growth.AnimalsWithoutBirthDate > 0)
        {
            <span>@T("{0} active animals have no birth date or estimated age, so their weights are not used.", _growth.AnimalsWithoutBirthDate)</span>
        }
        @T("Ages estimated from teeth (~) make the curve less precise.")
    </MudText>
}

@code {
    private List<FarmDto> _farms = [];
    private Guid? _farmId;
    private GrowthAnalysisDto? _growth;

    protected override async Task LoadAsync()
    {
        if (_farms.Count == 0) _farms = await Api.GetAsync<List<FarmDto>>("api/farms");
        _growth = await Api.GetAsync<GrowthAnalysisDto>($"api/analytics/growth{FarmFilter.Query(_farmId)}");
    }

    private async Task OnFarmChanged(Guid? farmId)
    {
        _farmId = farmId;
        await ReloadAsync();
    }

    private static List<ChartSeries> Series(GrowthCurveDto curve)
    {
        // Show the curve a year past the oldest animal weighed, so it is not dwarfed by an 8-year axis.
        var maxMonths = curve.Animals.Count == 0 ? 96 : Math.Min(96, curve.Animals.Max(a => a.AgeDays) / 30.44 + 12);
        return
        [
            new(T("Latest weights"), ChartColors.Secondary, SeriesKind.Points, curve.Animals.Select(a => new ChartPoint(
                a.AgeDays / 30.44, (double)a.WeightKg,
                $"{a.AnimalNo} · {a.TagNumber ?? T("no tag")}: " + T("{0:0} kg at {1}", a.WeightKg, AnimalText.Months((int)(a.AgeDays / 30.44))) +
                (a.DeviationPercent is { } d ? $" ({d:+0;-0}%)" : ""))).ToList()),
            new(T("Gompertz curve"), ChartColors.Primary, SeriesKind.Line,
                curve.Curve.Where(p => p.AgeMonths <= maxMonths).Select(p => new ChartPoint(p.AgeMonths, p.WeightKg)).ToList()),
        ];
    }

    private static double PeakGain(GrowthCurveDto curve) => curve.Curve.Count == 0 ? 0 : curve.Curve.Max(p => p.DailyGainKg);

    private static string WeightAt(GrowthCurveDto curve, int months) =>
        curve.Curve.FirstOrDefault(p => Math.Abs(p.AgeMonths - months) < 0.5)?.WeightKg.ToString("0") ?? "–";
}
