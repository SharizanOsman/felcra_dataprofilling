@* Shared form fields for registering / editing an animal. *@
<MudStack Spacing="2">
    @if (IsNew)
    {
        <MudSelect T="Guid" Value="Model.FarmId" ValueChanged="OnFarmChanged" Label="@T("Farm")" For="@(() => Model.FarmId)">
            @foreach (var farm in Lookups.Farms.Where(f => f.IsActive))
            {
                <MudSelectItem Value="farm.Id">@farm.Code — @farm.Name</MudSelectItem>
            }
        </MudSelect>
        <MudTextField @bind-Value="Model.TagNumber" For="@(() => Model.TagNumber)" Label="@T("Ear tag number")"
                      HelperText="@T("Leave empty if the animal has no tag yet.")" />
    }
    <MudSelect T="AnimalCategory" Value="Model.Category" ValueChanged="OnCategoryChanged" Label="@T("Category")" For="@(() => Model.Category)">
        @foreach (var c in Enum.GetValues<AnimalCategory>())
        {
            <MudSelectItem Value="c">@AnimalText.Category(c)</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="Guid?" @bind-Value="Model.BreedId" Label="@T("Breed")" Clearable="true" ToStringFunc="@(id => Lookups.BreedName(id) ?? "")">
        @foreach (var b in Lookups.Breeds.Where(b => b.IsActive || b.Id == Model.BreedId))
        {
            <MudSelectItem T="Guid?" Value="b.Id">@b.Name</MudSelectItem>
        }
    </MudSelect>
    <MudStack Row="true">
        <MudSelect T="Guid?" @bind-Value="Model.ProjectId" Label="@T("Project")" Clearable="true" ToStringFunc="@(id => Lookups.ProjectCode(id) ?? "")">
            @foreach (var p in Lookups.Projects.Where(p => p.IsActive || p.Id == Model.ProjectId))
            {
                <MudSelectItem T="Guid?" Value="p.Id">@p.Code</MudSelectItem>
            }
        </MudSelect>
        <MudSelect T="Guid?" @bind-Value="Model.HerdGroupId" Label="@T("Group / pen")" Clearable="true"
                   ToStringFunc="@(id => Lookups.GroupName(Model.FarmId, id) ?? "")">
            @foreach (var g in Lookups.Groups(Model.FarmId).Where(g => g.IsActive || g.Id == Model.HerdGroupId))
            {
                <MudSelectItem T="Guid?" Value="g.Id">@g.Name</MudSelectItem>
            }
        </MudSelect>
    </MudStack>
    <MudStack Row="true">
        <DateField Value="Model.BirthDate" ValueChanged="@(d => Model.BirthDate = d)" Label="@T("Birth date")" Max="DateOnly.FromDateTime(DateTime.Today)" />
        <MudSelect T="AgeEstimationMethod?" @bind-Value="Model.BirthDateMethod" For="@(() => Model.BirthDateMethod)" Label="@T("Birth date is")" Clearable="true"
                   ToStringFunc="@(m => m is null ? "" : EnumText.Humanize(m.Value))">
            @foreach (var m in Enum.GetValues<AgeEstimationMethod>())
            {
                <MudSelectItem T="AgeEstimationMethod?" Value="m">@EnumText.Humanize(m)</MudSelectItem>
            }
        </MudSelect>
    </MudStack>
    <MudTextField @bind-Value="Model.Remarks" For="@(() => Model.Remarks)" Label="@T("Remarks")" Lines="2" />
</MudStack>

@code {
    [Parameter, EditorRequired] public AnimalRequest Model { get; set; } = null!;
    [Parameter, EditorRequired] public Lookups Lookups { get; set; } = null!;
    [Parameter] public bool IsNew { get; set; }

    private void OnFarmChanged(Guid farmId)
    {
        Model.FarmId = farmId;
        Model.HerdGroupId = null;
    }

    // Sex always follows the census category.
    private void OnCategoryChanged(AnimalCategory category)
    {
        Model.Category = category;
        Model.Sex = Animal.SexOf(category);
    }
}
