@page "/animals/deleted"
@attribute [Authorize(Roles = Roles.HqAdmin)]
@inherits AdminPageBase

<MudBreadcrumbs Items="@([new(T("Animals"), "animals"), new(T("Deleted animals"), null, disabled: true)])" Class="px-0 pt-0" />
<PageHeader Title="@T("Deleted animals")" Subtitle="@T("Animals removed from the register; restore one deleted by mistake")" Error="@LoadError" />

<MudTable T="DeletedAnimalDto" Items="_animals" Dense="true" Elevation="1" Loading="IsLoading" Breakpoint="Breakpoint.Sm">
    <HeaderContent>
        <MudTh>@T("Animal no.")</MudTh>
        <MudTh>@T("Tag")</MudTh>
        <MudTh>@T("Category")</MudTh>
        <MudTh>@T("Farm")</MudTh>
        <MudTh>@T("Deleted")</MudTh>
        <MudTh></MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="@T("Animal no.")">@context.AnimalNo</MudTd>
        <MudTd DataLabel="@T("Tag")">@(context.TagNumber ?? T("no tag"))</MudTd>

        <MudTd DataLabel="@T("Category")">@AnimalText.Category(context.Category)</MudTd>
        <MudTd DataLabel="@T("Farm")">@context.FarmCode</MudTd>
        <MudTd DataLabel="@T("Deleted")">@context.DeletedAt?.ToLocalTime().ToString("dd MMM yyyy HH:mm")@(context.DeletedBy is null ? "" : " " + T("by {0}", context.DeletedBy))</MudTd>
        <MudTd Style="text-align:right">
            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.RestoreFromTrash"
                       OnClick="@(() => RestoreAsync(context))" aria-label="@($"Restore {context.AnimalNo}")">@T("Restore")</MudButton>
        </MudTd>
    </RowTemplate>
    <NoRecordsContent><MudText>@T("No deleted animals.")</MudText></NoRecordsContent>
</MudTable>
<MudText Typo="Typo.caption" Class="mt-2" Style="display:block">
    @T("Restoring brings the animal back with its records and the census entries removed with it. Restores are written to the audit log.")
</MudText>

@code {
    private List<DeletedAnimalDto> _animals = [];

    protected override async Task LoadAsync() => _animals = await Api.GetAsync<List<DeletedAnimalDto>>("api/animals/deleted");

    private async Task RestoreAsync(DeletedAnimalDto animal)
    {
        if (await Dialogs.ShowMessageBoxAsync(T("Restore animal"), T("Restore {0} (tag {1}) to the register?", animal.AnimalNo, animal.TagNumber ?? T("none")),
                yesText: T("Restore"), cancelText: T("Cancel")) != true)
            return;
        await NotifyAsync(await Api.PostAsync<object>($"api/animals/{animal.Id}/restore", new { }), T("{0} restored.", animal.AnimalNo));
    }
}
