@* Ear tag with warnings for untagged animals and tags shared with other animals. *@
@if (Tag is null)
{
    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">@T("No tag")</MudChip>
}
else
{
    <span>@Tag</span>
    @if (Duplicate)
    {
        <MudTooltip Text="@T("Another active animal on this farm has the same tag")">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" Style="vertical-align:middle" />
        </MudTooltip>
    }
}

@code {
    [Parameter] public string? Tag { get; set; }
    [Parameter] public bool Duplicate { get; set; }
}
