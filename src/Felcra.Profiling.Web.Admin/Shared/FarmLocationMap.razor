@* One farm on the map (farm page). *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_element" class="farm-map compact" data-testid="farm-location-map"></div>

@code {
    [Parameter, EditorRequired] public FarmDto Farm { get; set; } = null!;

    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _map;
    private DotNetObjectReference<FarmLocationMap>? _self;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Farm.Latitude is not { } lat || Farm.Longitude is not { } lon) return;
        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/farm-map.js");
        _map = await _module.InvokeAsync<IJSObjectReference>("createMap", _element, _self, new { picker = false, labels = MapLabels.Current });
        await _map.InvokeVoidAsync("setFarms", new[]
        {
            new { id = Farm.Id, code = Farm.Code, name = Farm.Name, lat, lon, radius = 9, active = Farm.IsActive, lines = new[] { Farm.Address, Farm.State }, link = false },
        });
        await _map.InvokeVoidAsync("flyTo", lat, lon, 14);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_map is not null)
            {
                await _map.InvokeVoidAsync("dispose");
                await _map.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // page is closing
        }
        _self?.Dispose();
    }
}
