@* Map of Malaysia with a pin per farm (size = active head). The state outlines are a local file
   (wwwroot/data/malaysia-states.json, built by tools/build-malaysia-map.mjs), so no map service is needed. *@
@using System.Globalization
@inject ApiClient Api
@inject NavigationManager Navigation

@if (_map is null)
{
    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="300px" />
}
else
{
    <svg viewBox="0 0 @_map.ViewBox[0] @_map.ViewBox[1]" role="img" aria-label="Map of Malaysia with the farms" style="width:100%;height:auto;max-height:380px;display:block">
        @foreach (var state in _map.States)
        {
            var farms = FarmsIn(state.Name);
            <path d="@state.Path" fill="@(farms.Count > 0 ? "var(--mud-palette-primary-lighten)" : "var(--mud-palette-background-gray)")"
                  fill-opacity="@(farms.Count > 0 ? "0.35" : "1")" stroke="var(--mud-palette-lines-default)" stroke-width="0.8" stroke-linejoin="round">
                <title>@StateTitle(state.Name, farms)</title>
            </path>
        }
        <line x1="@Num(_divider)" x2="@Num(_divider)" y1="16" y2="@(_map.ViewBox[1] - 16)" stroke="var(--mud-palette-lines-default)" stroke-dasharray="4 4" />
        @foreach (var farm in Located)
        {
            var (x, y) = Project(farm.Latitude!.Value, farm.Longitude!.Value);
            var r = Radius(farm);
            <g style="cursor:pointer" @onclick="@(() => Navigation.NavigateTo($"farms/{farm.FarmId}"))" data-testid="farm-pin">
                <circle cx="@Num(x)" cy="@Num(y)" r="@Num(r)" fill="var(--mud-palette-primary)" fill-opacity="@(farm.IsActive ? "0.85" : "0.35")"
                        stroke="var(--mud-palette-surface)" stroke-width="1.5">
                    <title>@($"{farm.Name} ({farm.Code}) · {farm.ActiveAnimals} active head" + (farm.Capacity is > 0 ? $" of {farm.Capacity}" : "") + (farm.IsActive ? "" : " · inactive"))</title>
                </circle>
                <text x="@Num(x + r + 4)" y="@Num(y + 4)" font-size="12" font-weight="600" fill="var(--mud-palette-text-primary)"
                      stroke="var(--mud-palette-surface)" stroke-width="3" paint-order="stroke">@farm.Code</text>
            </g>
        }
    </svg>
    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="3" Class="mt-2" AlignItems="AlignItems.Center">
        <MudText Typo="Typo.caption">@Summary</MudText>
        @if (Unlocated.Count > 0)
        {
            <MudText Typo="Typo.caption" Color="Color.Warning">
                No location yet: @string.Join(", ", Unlocated.Select(f => f.Code)) — edit the farm to add its latitude and longitude.
            </MudText>
        }
        <MudSpacer />
        <MudText Typo="Typo.caption" Color="Color.Secondary">Pin size = active head. Sabah and Sarawak are drawn closer to the peninsula.</MudText>
    </MudStack>
}

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FarmMapPointDto> Farms { get; set; } = [];

    private sealed record MapProjection(double LonMin, double LatMax, double EastShift, double EastFromLon, double Scale, double Pad);
    private sealed record MapState(string Name, string Type, bool East, string Path);
    private sealed record MapData(int[] ViewBox, MapProjection Projection, List<MapState> States);

    private MapData? _map;
    private double _divider;

    // Spellings people use for a state, mapped to the map's names.
    private static readonly Dictionary<string, string> Aliases = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Penang"] = "Pulau Pinang", ["Malacca"] = "Melaka", ["Negri Sembilan"] = "Negeri Sembilan",
        ["WP Kuala Lumpur"] = "Kuala Lumpur", ["Wilayah Persekutuan Kuala Lumpur"] = "Kuala Lumpur",
        ["WP Labuan"] = "Labuan", ["WP Putrajaya"] = "Putrajaya",
    };

    protected override async Task OnInitializedAsync()
    {
        _map = await Api.GetAsync<MapData>("admin/data/malaysia-states.json");
        // Between the peninsula's east coast (104.6°E) and Borneo's west (109.5°E), after the shift.
        _divider = (X(104.6, false) + X(109.5, true)) / 2;
    }

    private IEnumerable<FarmMapPointDto> Located => Farms.Where(f => f.Latitude is not null && f.Longitude is not null);
    private List<FarmMapPointDto> Unlocated => Farms.Where(f => f.Latitude is null || f.Longitude is null).ToList();

    private List<FarmMapPointDto> FarmsIn(string state) =>
        Farms.Where(f => f.State is { } s && (Aliases.GetValueOrDefault(s.Trim()) ?? s.Trim()).Equals(state, StringComparison.OrdinalIgnoreCase)).ToList();

    private static string StateTitle(string state, List<FarmMapPointDto> farms) =>
        farms.Count == 0 ? state : $"{state}: {farms.Count} farm{(farms.Count == 1 ? "" : "s")}, {farms.Sum(f => f.ActiveAnimals)} active head";

    private string Summary
    {
        get
        {
            var states = Farms.Select(f => f.State).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct().Count();
            return $"{Farms.Count} farm{(Farms.Count == 1 ? "" : "s")} in {states} state{(states == 1 ? "" : "s")} · {Farms.Sum(f => f.ActiveAnimals)} active head";
        }
    }

    private double X(double lon, bool east) => _map!.Projection.Pad + (lon - _map.Projection.LonMin - (east ? _map.Projection.EastShift : 0)) * _map.Projection.Scale;
    private double Y(double lat) => _map!.Projection.Pad + (_map.Projection.LatMax - lat) * _map.Projection.Scale;

    private (double X, double Y) Project(decimal lat, decimal lon) =>
        (X((double)lon, (double)lon >= _map!.Projection.EastFromLon), Y((double)lat));

    private static double Radius(FarmMapPointDto farm) => Math.Min(18, 5 + Math.Sqrt(farm.ActiveAnimals) * 0.6);

    private static string Num(double value) => value.ToString("0.#", CultureInfo.InvariantCulture);
}
