@* The farm's location in the farm form: search a place or paste GPS coordinates, click the map or drag the pin,
   use the phone's GPS, or type latitude and longitude. Fills in the state when it is still empty. *@
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ApiClient Api

@* The state lives here too: a place picked on the map fills it in, and it must show at once. *@
<MudSelect T="string" @bind-Value="Model.State" For="@(() => Model.State)" Label="@T("State")" Clearable="true">
    @foreach (var state in MalaysianStates.All)
    {
        <MudSelectItem Value="state">@state</MudSelectItem>
    }
</MudSelect>
<MudText Typo="Typo.subtitle2" Class="mt-3">@T("Location")</MudText>
<MudStack Row="true" Spacing="2" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap">
    <div style="flex:1;min-width:220px">
        <PlaceSearch OnSelected="OnPlaceSelected" Placeholder="@T("Search place or paste GPS / Google Maps link")" />
    </div>
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.MyLocation" OnClick="UseMyLocationAsync" Disabled="_locating" Class="mt-1">
        @(_locating ? T("Finding you…") : T("Use my location"))
    </MudButton>
</MudStack>
<div @ref="_element" class="farm-map compact mt-2" data-testid="location-picker-map"></div>
<MudText Typo="Typo.caption" Style="display:block">
    @T("Click the map or drag the red pin to the farm. Switch to Satellite to see the pens and fields.")
</MudText>
<MudStack Row="true">
    <MudNumericField T="decimal?" Value="Model.Latitude" ValueChanged="OnLatitudeTyped" For="@(() => Model.Latitude)" Label="@T("Latitude")"
                     HideSpinButtons="true" Format="0.######" Culture="@System.Globalization.CultureInfo.InvariantCulture" />
    <MudNumericField T="decimal?" Value="Model.Longitude" ValueChanged="OnLongitudeTyped" For="@(() => Model.Longitude)" Label="@T("Longitude")"
                     HideSpinButtons="true" Format="0.######" Culture="@System.Globalization.CultureInfo.InvariantCulture" />
</MudStack>
@if (_near is not null)
{
    <MudText Typo="Typo.caption" Style="display:block" data-testid="location-near">@T("Near: {0}", _near)</MudText>
}
@if (_message is not null)
{
    <MudText Typo="Typo.caption" Color="Color.Warning" Style="display:block">@_message</MudText>
}

@code {
    [Parameter, EditorRequired] public FarmRequest Model { get; set; } = null!;

    private ElementReference _element;
    private IJSObjectReference? _module;
    private IJSObjectReference? _map;
    private DotNetObjectReference<LocationPicker>? _self;
    private string? _near;
    private string? _message;
    private bool _locating;
    private int _lookup;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/farm-map.js");
        _map = await _module.InvokeAsync<IJSObjectReference>("createMap", _element, _self, new { picker = true, labels = MapLabels.Current });
        if (Model.Latitude is { } lat && Model.Longitude is { } lon)
        {
            await _map.InvokeVoidAsync("setPin", lat, lon, true);
            await DescribeAsync(lat, lon);
        }
    }

    /// <summary>The map was clicked or the pin dragged.</summary>
    [JSInvokable]
    public async Task OnPicked(double latitude, double longitude)
    {
        Set((decimal)latitude, (decimal)longitude);
        StateHasChanged();
        await DescribeAsync(Model.Latitude!.Value, Model.Longitude!.Value);
    }


    private async Task OnPlaceSelected(PlaceResult place)
    {
        if (place.Latitude is not { } lat || place.Longitude is not { } lon) return;
        Set(lat, lon);
        _near = place.Detail ?? place.Title;
        SuggestState(place.State);
        if (_map is not null) await _map.InvokeVoidAsync("setPin", lat, lon, true);
    }

    private async Task UseMyLocationAsync()
    {
        if (_module is null) return;
        _locating = true;
        _message = null;
        try
        {
            var here = await _module.InvokeAsync<Position>("locate");
            await OnPicked(here.Lat, here.Lon);
            if (_map is not null) await _map.InvokeVoidAsync("setPin", Model.Latitude, Model.Longitude, true);
            if (here.Accuracy > 100) _message = T("Your location is only accurate to about {0:0} m; check the pin.", here.Accuracy);
        }
        catch (JSException ex)
        {
            _message = ex.Message.Contains("denied")
                ? T("Location access was refused. Allow it for this site in the browser, or search or click the map instead.")
                : T("Your location could not be found. Search or click the map instead.");
        }
        finally
        {
            _locating = false;
        }
    }

    private async Task OnLatitudeTyped(decimal? value)
    {
        Model.Latitude = value;
        await MovePinAsync();
    }

    private async Task OnLongitudeTyped(decimal? value)
    {
        Model.Longitude = value;
        await MovePinAsync();
    }

    private async Task MovePinAsync()
    {
        if (_map is null) return;
        if (Model.Latitude is { } lat && Model.Longitude is { } lon) await _map.InvokeVoidAsync("setPin", lat, lon, true);
        else await _map.InvokeVoidAsync("clearPin");
    }

    private void Set(decimal latitude, decimal longitude)
    {
        Model.Latitude = Math.Round(latitude, 6);
        Model.Longitude = Math.Round(longitude, 6);
    }

    /// <summary>Names the place at the pin (and suggests the state). Only the latest of quick successive drags is shown.</summary>
    private async Task DescribeAsync(decimal lat, decimal lon)
    {
        var lookup = ++_lookup;
        var place = await Api.TryGetAsync<GeoPlaceDto>(FormattableString.Invariant($"api/geocode/reverse?lat={lat}&lon={lon}"));
        if (lookup != _lookup) return;
        _near = place.Value?.DisplayName;
        SuggestState(place.Value?.State);
        StateHasChanged();
    }

    private void SuggestState(string? state)
    {
        if (string.IsNullOrEmpty(Model.State) && state is not null) Model.State = state;
    }

    private sealed record Position(double Lat, double Lon, double Accuracy);

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_map is not null)
            {
                await _map.InvokeVoidAsync("dispose");
                await _map.DisposeAsync();
            }
            if (_module is not null) await _module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // dialog closed with the page
        }
        _self?.Dispose();
    }
}
