@page "/a/{Id:guid}"
@attribute [Authorize(Roles = $"{Roles.FarmManager},{Roles.FieldOfficer}")]
@inject ApiClient Api
@inject RecentAnimals Recent

@* Target of the QR code on ear-tag labels. *@
<PageTitle>Animal — FELCRA Field</PageTitle>

@if (_error is not null)
{
    <MudAlert Severity="Severity.Error">@_error</MudAlert>
}
else if (_animal is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <AnimalHeader Animal="_animal" />

    @if (_animal.Status == AnimalStatus.Active)
    {
        <MudGrid Spacing="2" Class="mb-4">
            <MudItem xs="6"><ActionButton Href="@($"a/{Id}/measure/weight")" Icon="@Icons.Material.Filled.MonitorWeight" Text="Weight" Detail="@Latest(MeasurementType.Weight)" /></MudItem>
            <MudItem xs="6"><ActionButton Href="@($"a/{Id}/measure/bcs")" Icon="@Icons.Material.Filled.FitnessCenter" Text="Body condition" Detail="@Latest(MeasurementType.BodyCondition)" /></MudItem>
            <MudItem xs="6"><ActionButton Href="@($"a/{Id}/treatment")" Icon="@Icons.Material.Filled.Vaccines" Text="Treatment" /></MudItem>
            <MudItem xs="6"><ActionButton Href="@($"a/{Id}/observation")" Icon="@Icons.Material.Filled.PhotoCamera" Text="Observation" /></MudItem>
            @if (_animal.Category == AnimalCategory.Dam)
            {
                <MudItem xs="6"><ActionButton Href="@($"a/{Id}/measure/milk")" Icon="@Icons.Material.Filled.LocalDrink" Text="Milk yield" Detail="@Latest(MeasurementType.MilkYield)" /></MudItem>
            }
        </MudGrid>
    }

    <MudText Typo="Typo.subtitle1" Class="mb-1">History</MudText>
    @if (_timeline.Count == 0)
    {
        <MudText Typo="Typo.body2">Nothing recorded yet.</MudText>
    }
    <MudTimeline TimelinePosition="TimelinePosition.Start" Class="pt-0">
        @foreach (var item in _timeline)
        {
            <MudTimelineItem Color="item.Color" Size="Size.Small" Elevation="0">
                <MudText Typo="Typo.body1"><strong>@item.Title</strong></MudText>
                <MudText Typo="Typo.caption" Style="display:block">@item.Date.ToString("dd MMM yyyy")@(item.By is null ? "" : $" · {item.By}")</MudText>
                @if (item.Detail is not null) { <MudText Typo="Typo.body2">@item.Detail</MudText> }
                @if (item.PhotoIds.Count > 0)
                {
                    <MudStack Row="true" Spacing="1" Class="mt-1">
                        @foreach (var photo in item.PhotoIds)
                        {
                            <AuthImage Url="@($"api/photos/{photo}")" Style="width:72px;height:72px;object-fit:cover;border-radius:4px" Width="72px" Height="72px" />
                        }
                    </MudStack>
                }
            </MudTimelineItem>
        }
    </MudTimeline>
}

@code {
    [Parameter] public Guid Id { get; set; }

    private AnimalDto? _animal;
    private AnimalRecordsDto? _records;
    private List<TimelineItem> _timeline = [];
    private string? _error;

    private sealed record TimelineItem(DateOnly Date, DateTimeOffset Order, string Title, string? Detail, string? By, Color Color, IReadOnlyList<Guid> PhotoIds);

    protected override async Task OnParametersSetAsync()
    {
        _error = null;
        try
        {
            var animal = Api.GetAsync<AnimalDto>($"api/animals/{Id}");
            var records = Api.GetAsync<AnimalRecordsDto>($"api/animals/{Id}/records");
            (_animal, _records) = (await animal, await records);
            _timeline = BuildTimeline(_animal, _records);
            await Recent.AddAsync(new RecentAnimal(_animal.Id, _animal.AnimalNo, _animal.TagNumber, AnimalText.Category(_animal.Category)));
        }
        catch (HttpRequestException ex)
        {
            _error = ex.StatusCode == System.Net.HttpStatusCode.NotFound
                ? "This animal is not on any of your farms."
                : "Could not load the animal. Check your connection.";
        }
    }

    private string? Latest(MeasurementType type) =>
        _records?.Measurements.FirstOrDefault(m => m.Type == type) is { } m ? $"{FieldText.Measurement(m.Type, m.Value)} · {m.MeasuredOn:dd MMM}" : null;

    private static List<TimelineItem> BuildTimeline(AnimalDto animal, AnimalRecordsDto records)
    {
        var items = new List<TimelineItem>();
        items.AddRange(records.Measurements.Select(m => new TimelineItem(
            m.MeasuredOn, m.RecordedAt, FieldText.Measurement(m.Type, m.Value),
            string.Join(" · ", new[] { m.Method is null ? null : EnumText.Humanize(m.Method.Value), m.Notes }.Where(s => s is not null)) is { Length: > 0 } d ? d : null,
            m.RecordedBy, Color.Primary, [])));
        items.AddRange(records.Treatments.Select(t => new TimelineItem(
            t.GivenOn, t.RecordedAt, t.ProductName,
            string.Join(" · ", new[]
            {
                t.Dose is null ? null : $"{t.Dose:0.###} {t.DoseUnit}",
                t.Route is null ? null : EnumText.Humanize(t.Route.Value),
                t.NextDueOn is null ? null : $"next due {t.NextDueOn:dd MMM yyyy}",
                t.WithdrawalUntil is null ? null : $"no slaughter before {t.WithdrawalUntil:dd MMM yyyy}",
                t.Notes,
            }.Where(s => s is not null)) is { Length: > 0 } d ? d : null,
            t.RecordedBy, Color.Secondary, [])));
        items.AddRange(records.Observations.Select(o => new TimelineItem(
            o.ObservedOn, o.RecordedAt, EnumText.Humanize(o.Category), o.Notes, o.RecordedBy, Color.Warning, o.PhotoIds)));
        items.AddRange(animal.CensusHistory.Select(c => new TimelineItem(
            c.SessionStartDate, default, $"Census: {c.SessionTitle}",
            string.Join(" · ", new[] { AnimalText.Category(c.Category), AnimalText.Weight(c.WeightKg), c.Selected ? "selected" : null }
                .Where(s => !string.IsNullOrEmpty(s))),
            null, Color.Info, [])));
        return items.OrderByDescending(i => i.Date).ThenByDescending(i => i.Order).ToList();
    }
}
