@page "/"
@attribute [Authorize(Roles = $"{Roles.FarmManager},{Roles.FieldOfficer}")]
@implements IDisposable
@inject RecentAnimals Recent
@inject SyncService Sync
@inject FieldData Data

<PageTitle>FELCRA Field</PageTitle>

<AuthorizeView>
    <MudText Typo="Typo.h6" Class="mb-3">Hello, @context.User.FindFirst(AppClaimTypes.FullName)?.Value</MudText>
</AuthorizeView>

<MudStack Spacing="3">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" Href="scan"
               StartIcon="@Icons.Material.Filled.QrCodeScanner" Style="height:72px;font-size:1.1rem">Scan ear tag</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" FullWidth="true" Href="find"
               StartIcon="@Icons.Material.Filled.Search" Style="height:56px">Find by tag number</MudButton>
</MudStack>

<MudPaper Class="pa-3 mt-4" Elevation="0" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <SyncIndicator />
        <div>
            <MudText Typo="Typo.body2">
                @if (Sync.AnimalCount == 0)
                {
                    <span>@(Sync.IsOnline ? "Downloading your farm's animals…" : "Connect to the internet once to download your farm's animals.")</span>
                }
                else
                {
                    <span>@Sync.AnimalCount animals on this phone</span>
                }
            </MudText>
            <MudText Typo="Typo.caption">
                @(Sync.LastSyncedAt is { } last ? $"Last synced {last.ToLocalTime():dd MMM HH:mm}" : "Not synced yet")
                @if (Sync.PendingCount > 0) { <span> · @Sync.PendingCount waiting to send</span> }
                @if (Sync.FailedCount > 0) { <span style="color:var(--mud-palette-error)"> · @Sync.FailedCount not accepted</span> }
            </MudText>
        </div>
        <MudSpacer />
        <MudButton Variant="Variant.Text" Href="sync">Details</MudButton>
    </MudStack>
</MudPaper>

@if (_tasks.Count > 0)
{
    <MudText Typo="Typo.subtitle1" Class="mt-5 mb-1">Tasks (@_tasks.Count)</MudText>
    <MudList T="string" Dense="true">
        @foreach (var task in _tasks.Take(_showAllTasks ? _tasks.Count : 6))
        {
            <MudListItem T="string" Href="@($"a/{task.AnimalId}")" Icon="@BreedingText.ReminderIcon(task.Type)"
                         IconColor="@(task.IsOverdueOn(_today) ? Color.Error : Color.Primary)">
                <strong>@task.Title</strong>
                @if (task.IsOverdueOn(_today))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Text">overdue</MudChip>
                }
                <MudText Typo="Typo.caption" Style="display:block">
                    @(task.TagNumber is null ? "No tag" : $"Tag {task.TagNumber}") · @task.AnimalNo · @(task.DueDate == _today ? "today" : task.DueDate.ToString("dd MMM"))
                </MudText>
            </MudListItem>
        }
    </MudList>
    @if (_tasks.Count > 6 && !_showAllTasks)
    {
        <MudButton Variant="Variant.Text" OnClick="@(() => _showAllTasks = true)">Show all @_tasks.Count tasks</MudButton>
    }
}

@if (_recent.Count > 0)
{
    <MudText Typo="Typo.subtitle1" Class="mt-5 mb-1">Recently opened</MudText>
    <MudList T="string" Dense="false">
        @foreach (var a in _recent)
        {
            <MudListItem T="string" Href="@($"a/{a.Id}")" Icon="@Icons.Material.Filled.Pets">
                <strong>@(a.TagNumber is null ? "No tag" : $"Tag {a.TagNumber}")</strong>
                <MudText Typo="Typo.caption" Style="display:block">@a.AnimalNo · @a.Category</MudText>
            </MudListItem>
        }
    </MudList>
}

@code {
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private List<RecentAnimal> _recent = [];
    private List<ReminderDto> _tasks = [];
    private bool _showAllTasks;

    protected override async Task OnInitializedAsync()
    {
        Sync.Changed += OnSyncChanged;
        _recent = await Recent.GetAsync();
        _tasks = await Data.RemindersAsync();
    }

    // Tasks are refreshed with each sync.
    private void OnSyncChanged() => _ = InvokeAsync(async () =>
    {
        if (!Sync.IsSyncing) _tasks = await Data.RemindersAsync();
        StateHasChanged();
    });

    public void Dispose() => Sync.Changed -= OnSyncChanged;
}
