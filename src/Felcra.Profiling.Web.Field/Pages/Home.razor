@page "/"
@attribute [Authorize(Roles = $"{Roles.FarmManager},{Roles.FieldOfficer}")]

<PageTitle>Home — FELCRA Field</PageTitle>

<AuthorizeView>
    <MudText Typo="Typo.h5" GutterBottom="true">Hello, @context.User.FindFirst(AppClaimTypes.FullName)?.Value</MudText>
</AuthorizeView>

<MudStack Spacing="3">
    @* Enabled in Step 4 (QR scan & recording). *@
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true"
               StartIcon="@Icons.Material.Filled.QrCodeScanner" Disabled="true">Scan ear tag</MudButton>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Large" FullWidth="true"
               StartIcon="@Icons.Material.Filled.Search" Disabled="true">Find animal</MudButton>
    <MudText Typo="Typo.caption" Align="Align.Center">Recording features arrive in the next release.</MudText>
</MudStack>
