@page "/a/{Id:guid}/observation"
@attribute [Authorize(Roles = $"{Roles.FarmManager},{Roles.FieldOfficer}")]
@inherits RecordPageBase

<PageTitle>@T("Observation — FELCRA Field")</PageTitle>

@if (LoadError is not null)
{
    <MudAlert Severity="Severity.Error">@LoadError</MudAlert>
}
else if (Animal is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <AnimalHeader Animal="Animal" DuplicateTag="DuplicateTag" />
    <MudText Typo="Typo.h6" Class="mb-2">@T("Health / condition observation")</MudText>

    <MudForm @ref="_form" Model="_model" Validation="@Validate" ValidationDelay="0">
        <MudStack Spacing="3">
            <MudSelect T="ObservationCategory" @bind-Value="_model.Category" Label="@T("Type")" Variant="Variant.Outlined">
                @foreach (var c in Enum.GetValues<ObservationCategory>())
                {
                    <MudSelectItem Value="c">@EnumText.Humanize(c)</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_model.Notes" For="@(() => _model.Notes)" Label="@T("What did you see?")" Variant="Variant.Outlined" Lines="4" />
            <DateField Value="_model.ObservedOn" ValueChanged="@(d => _model.ObservedOn = d ?? _model.ObservedOn)" Label="@T("Date")" Clearable="false"
                       Max="DateOnly.FromDateTime(DateTime.Today)" />

            <div>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    @foreach (var photo in _photos)
                    {
                        <img src="@photo.Preview" alt="@T("Photo")" style="width:84px;height:84px;object-fit:cover;border-radius:6px" />
                    }
                </MudStack>
                @if (_photos.Count < MaxPhotos)
                {
                    <label class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-button-outlined-size-medium mt-2" style="cursor:pointer">
                        <MudIcon Icon="@Icons.Material.Filled.AddAPhoto" Class="mr-2" /> @(_uploading ? T("Uploading…") : T("Add photo"))
                        <InputFile OnChange="OnPhotoSelected" accept="image/*" capture="environment" style="display:none" disabled="@_uploading" />
                    </label>
                }
            </div>

            @if (SaveError is not null) { <MudAlert Severity="Severity.Error" Dense="true">@SaveError</MudAlert> }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="SubmitAsync"
                       Disabled="@(Saving || _uploading || Animal.Status != AnimalStatus.Active)" Style="height:56px">
                @(Saving ? T("Saving…") : T("Save"))
            </MudButton>
        </MudStack>
    </MudForm>
}

@code {
    private const int MaxPhotos = 5;
    private static readonly Func<object, string, Task<IEnumerable<string>>> Validate = FormValidation.For(new ObservationRequestValidator());
    private MudForm _form = null!;
    private readonly ObservationRequest _model = new();
    private readonly List<(Guid Id, string Base64, string Preview)> _photos = [];
    private bool _uploading;

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        _uploading = true;
        SaveError = null;
        try
        {
            // Phone photos are several MB; shrink in the browser before storing and sending them.
            var resized = await e.File.RequestImageFileAsync("image/jpeg", 1600, 1600);
            using var buffer = new MemoryStream();
            await resized.OpenReadStream(8 * 1024 * 1024).CopyToAsync(buffer);
            var base64 = Convert.ToBase64String(buffer.ToArray());

            // Kept on the phone; uploaded together with the observation when it is saved.
            _photos.Add((Guid.CreateVersion7(), base64, $"data:image/jpeg;base64,{base64}"));
            _model.PhotoIds = _photos.Select(p => p.Id).ToList();
        }
        catch (IOException)
        {
            SaveError = T("The photo is too large.");
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        // Photos are queued just ahead of the observation that refers to them, so they are sent first.
        var queuedAt = DateTimeOffset.UtcNow.AddMilliseconds(-_photos.Count - 1);
        foreach (var (photo, index) in _photos.Select((p, i) => (p, i)))
        {
            await Data.SavePhotoAsync(new PendingPhoto(photo.Id, Id, "image/jpeg", photo.Base64));
            await Data.EnqueueAsync(MakeItem(photo.Id, OutboxKind.Photo, "", T("Photo {0}", index + 1), _model.ObservedOn) with
            {
                Key = OutboxItem.MakeKey(queuedAt.AddMilliseconds(index), photo.Id),
            });
        }

        var summary = EnumText.Humanize(_model.Category) + (_photos.Count > 0 ? " " + T(_photos.Count > 1 ? "({0} photos)" : "({0} photo)", _photos.Count) : "");
        await SaveAsync(_model.Id, OutboxKind.Observation, _model, summary, _model.ObservedOn);
    }
}
