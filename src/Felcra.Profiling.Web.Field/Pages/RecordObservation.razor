@page "/a/{Id:guid}/observation"
@attribute [Authorize(Roles = $"{Roles.FarmManager},{Roles.FieldOfficer}")]
@inherits RecordPageBase

<PageTitle>Observation — FELCRA Field</PageTitle>

@if (LoadError is not null)
{
    <MudAlert Severity="Severity.Error">@LoadError</MudAlert>
}
else if (Animal is null)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <AnimalHeader Animal="Animal" />
    <MudText Typo="Typo.h6" Class="mb-2">Health / condition observation</MudText>

    <MudForm @ref="_form" Model="_model" Validation="@Validate" ValidationDelay="0">
        <MudStack Spacing="3">
            <MudSelect T="ObservationCategory" @bind-Value="_model.Category" Label="Type" Variant="Variant.Outlined">
                @foreach (var c in Enum.GetValues<ObservationCategory>())
                {
                    <MudSelectItem Value="c">@EnumText.Humanize(c)</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_model.Notes" For="@(() => _model.Notes)" Label="What did you see?" Variant="Variant.Outlined" Lines="4" />
            <DateField Value="_model.ObservedOn" ValueChanged="@(d => _model.ObservedOn = d ?? _model.ObservedOn)" Label="Date" Clearable="false"
                       Max="DateOnly.FromDateTime(DateTime.Today)" />

            <div>
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                    @foreach (var photo in _photos)
                    {
                        <img src="@photo.Preview" alt="Photo" style="width:84px;height:84px;object-fit:cover;border-radius:6px" />
                    }
                </MudStack>
                @if (_photos.Count < MaxPhotos)
                {
                    <label class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-button-outlined-size-medium mt-2" style="cursor:pointer">
                        <MudIcon Icon="@Icons.Material.Filled.AddAPhoto" Class="mr-2" /> @(_uploading ? "Uploading…" : "Add photo")
                        <InputFile OnChange="OnPhotoSelected" accept="image/*" capture="environment" style="display:none" disabled="@_uploading" />
                    </label>
                }
            </div>

            @if (SaveError is not null) { <MudAlert Severity="Severity.Error" Dense="true">@SaveError</MudAlert> }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large" FullWidth="true" OnClick="SubmitAsync"
                       Disabled="@(Saving || _uploading || Animal.Status != AnimalStatus.Active)" Style="height:56px">
                @(Saving ? "Saving…" : "Save")
            </MudButton>
        </MudStack>
    </MudForm>
}

@code {
    private const int MaxPhotos = 5;
    private static readonly Func<object, string, Task<IEnumerable<string>>> Validate = FormValidation.For(new ObservationRequestValidator());
    private MudForm _form = null!;
    private readonly ObservationRequest _model = new();
    private readonly List<(Guid Id, string Preview)> _photos = [];
    private bool _uploading;

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        _uploading = true;
        SaveError = null;
        try
        {
            // Phone photos are several MB; shrink in the browser before sending over a weak connection.
            var resized = await e.File.RequestImageFileAsync("image/jpeg", 1600, 1600);
            using var buffer = new MemoryStream();
            await resized.OpenReadStream(8 * 1024 * 1024).CopyToAsync(buffer);
            var bytes = buffer.ToArray();

            var result = await Api.PostFileAsync<PhotoDto>($"api/animals/{Id}/photos", new MemoryStream(bytes), "photo.jpg", "image/jpeg");
            if (!result.Succeeded)
            {
                SaveError = result.FullError;
                return;
            }
            _photos.Add((result.Value!.Id, $"data:image/jpeg;base64,{Convert.ToBase64String(bytes)}"));
            _model.PhotoIds = _photos.Select(p => p.Id).ToList();
        }
        catch (IOException)
        {
            SaveError = "The photo is too large.";
        }
        finally
        {
            _uploading = false;
        }
    }

    private async Task SubmitAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid) return;
        await SaveAsync<ObservationDto>("observations", _model, "Observation saved.");
    }
}
