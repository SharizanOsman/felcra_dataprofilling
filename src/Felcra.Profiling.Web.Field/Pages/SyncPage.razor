@page "/sync"
@attribute [Authorize(Roles = $"{Roles.FarmManager},{Roles.FieldOfficer}")]
@implements IDisposable
@inject SyncService Sync
@inject FieldData Data
@inject IDialogService Dialogs
@inject ApiClient Api
@inject AuthClient Auth
@inject ISnackbar Snackbar

<PageTitle>Sync — FELCRA Field</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-3">
    <SyncIndicator />
    <div>
        <MudText Typo="Typo.h6">@(Sync.IsOnline ? "Online" : "Offline")</MudText>
        <MudText Typo="Typo.caption">
            @Sync.AnimalCount animals on this phone · @(Sync.LastSyncedAt is { } last ? $"last synced {last.ToLocalTime():dd MMM HH:mm}" : "not synced yet")
        </MudText>
    </div>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Sync" OnClick="Sync.SyncNowAsync"
               Disabled="@(!Sync.IsOnline || Sync.IsSyncing)">Sync now</MudButton>
</MudStack>

@if (_items.Count == 0)
{
    <MudAlert Severity="Severity.Success">Everything recorded on this phone has been sent.</MudAlert>
}
else
{
    @if (_items.Any(i => i.Error is not null))
    {
        <MudAlert Severity="Severity.Error" Class="mb-2" Dense="true">
            The server did not accept some records. Check the reason; retry if it was fixed (e.g. the animal is active again) or discard.
        </MudAlert>
    }
    <MudList T="string">
        @foreach (var item in _items.Where(i => i.Kind != OutboxKind.Photo || i.Error is not null))
        {
            <MudListItem T="string">
                <MudStack Row="true" AlignItems="AlignItems.Start">
                    <div style="flex:1">
                        <MudText Typo="Typo.body1"><strong>@item.Summary</strong></MudText>
                        <MudText Typo="Typo.caption" Style="display:block">
                            @AnimalLabel(item.AnimalId) · @item.Date.ToString("dd MMM yyyy") · saved @item.QueuedAt.ToLocalTime().ToString("dd MMM HH:mm")
                        </MudText>
                        @if (item.Error is not null)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Error">@item.Error</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">Waiting to send@(item.Attempts > 0 ? $" ({item.Attempts} attempt{(item.Attempts > 1 ? "s" : "")})" : "")</MudText>
                        }
                    </div>
                    @if (item.Error is not null)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Replay" OnClick="() => Sync.RetryAsync(item)" aria-label="Retry" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="() => DiscardAsync(item)" aria-label="Discard" />
                    }
                </MudStack>
            </MudListItem>
        }
    </MudList>
}

<div class="mt-6">
    <NotificationSettings />
</div>

<MudPaper Class="pa-3 mt-3" Elevation="0" Outlined="true">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" />
        <div style="flex:1">
            <MudText Typo="Typo.subtitle2">Account</MudText>
            <AuthorizeView>
                <MudText Typo="Typo.caption" Style="display:block">Signed in as @context.User.FindFirst(AppClaimTypes.FullName)?.Value</MudText>
            </AuthorizeView>
        </div>
        <MudButton Variant="Variant.Outlined" Disabled="@(!Sync.IsOnline)" OnClick="ChangePasswordAsync">Change password</MudButton>
    </MudStack>
</MudPaper>

@code {
    private List<OutboxItem> _items = [];

    private async Task ChangePasswordAsync()
    {
        if (await Dialogs.ChangePasswordAsync(Api, Auth))
            Snackbar.Add("Password changed. Other devices signed in as you have been signed out.", Severity.Success);
    }
    private Dictionary<Guid, SyncAnimalDto> _animals = [];

    protected override async Task OnInitializedAsync()
    {
        Sync.Changed += OnChanged;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _items = await Data.OutboxAsync();
        _animals = (await Data.AnimalsAsync()).ToDictionary(a => a.Id);
    }

    private string AnimalLabel(Guid id) =>
        _animals.TryGetValue(id, out var a) ? $"{(a.TagNumber is null ? "No tag" : $"Tag {a.TagNumber}")} · {a.AnimalNo}" : "Unknown animal";

    private async Task DiscardAsync(OutboxItem item)
    {
        if (await Dialogs.ShowMessageBoxAsync("Discard record", $"Discard \"{item.Summary}\"? It has not been saved on the server.",
                yesText: "Discard", cancelText: "Keep") == true)
            await Sync.DiscardAsync(item);
    }

    private void OnChanged() => _ = InvokeAsync(async () =>
    {
        await LoadAsync();
        StateHasChanged();
    });

    public void Dispose() => Sync.Changed -= OnChanged;
}
