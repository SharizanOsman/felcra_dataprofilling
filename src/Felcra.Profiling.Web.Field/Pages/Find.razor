@page "/find"
@attribute [Authorize(Roles = $"{Roles.FarmManager},{Roles.FieldOfficer}")]
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Find animal — FELCRA Field</PageTitle>

<MudTextField T="string" Value="_query" ValueChanged="SearchAsync" Label="Tag number or animal no." Variant="Variant.Outlined"
              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Search" DebounceInterval="400" Immediate="true"
              InputMode="InputMode.search" AutoFocus="true" Clearable="true" />

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-2" />
}
else if (_error is not null)
{
    <MudAlert Severity="Severity.Error" Class="mt-3">@_error</MudAlert>
}
else if (_results is not null)
{
    @if (_results.Count == 0)
    {
        <MudText Class="mt-4">No active animal matches "@_query".</MudText>
    }
    else
    {
        @if (_results.Count > 1 && _results.Select(r => r.TagNumber).Distinct().Count() < _results.Count)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">Several animals share this tag. Check the category and age to pick the right one.</MudAlert>
        }
        <MudList T="string" Class="mt-2">
            @foreach (var a in _results)
            {
                <MudListItem T="string" Href="@($"a/{a.Id}")">
                    <strong>@(a.TagNumber is null ? "No tag" : $"Tag {a.TagNumber}")</strong> · @a.AnimalNo
                    <MudText Typo="Typo.caption" Style="display:block">
                        @AnimalText.Category(a.Category) · @AnimalText.Age(a.BirthDate, a.BirthDateMethod, _today)
                        @(a.LatestWeightKg is null ? "" : $" · {AnimalText.Weight(a.LatestWeightKg)}") · @a.FarmCode @a.ProjectCode
                    </MudText>
                </MudListItem>
            }
        </MudList>
    }
}

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Initial { get; set; }

    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);
    private string? _query;
    private List<AnimalListItemDto>? _results;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Initial)) await SearchAsync(Initial);
    }

    private async Task SearchAsync(string? query)
    {
        _query = query;
        _error = null;
        if (string.IsNullOrWhiteSpace(query))
        {
            _results = null;
            return;
        }

        _loading = true;
        try
        {
            var page = await Api.GetAsync<PagedResult<AnimalListItemDto>>($"api/animals?search={Uri.EscapeDataString(query.Trim())}&sort=tag&pageSize=30");
            _results = [.. page.Items];
            // One exact match: open it straight away.
            if (_results.Count == 1 && string.Equals(_results[0].TagNumber, query.Trim(), StringComparison.OrdinalIgnoreCase))
                Navigation.NavigateTo($"a/{_results[0].Id}");
        }
        catch (HttpRequestException)
        {
            _error = "Cannot reach the server. Check your connection.";
        }
        finally
        {
            _loading = false;
        }
    }
}
