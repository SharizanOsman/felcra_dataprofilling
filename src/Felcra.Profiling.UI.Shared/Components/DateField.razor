@* MudDatePicker works with DateTime?; the API uses DateOnly?. *@
<MudDatePicker Label="@Label" Date="@(Value?.ToDateTime(TimeOnly.MinValue))" DateChanged="OnChanged"
               DateFormat="dd MMM yyyy" Clearable="@Clearable" Editable="true" HelperText="@HelperText"
               MaxDate="@(Max?.ToDateTime(TimeOnly.MinValue))" Required="@Required" />

@code {
    [Parameter] public DateOnly? Value { get; set; }
    [Parameter] public EventCallback<DateOnly?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Required { get; set; }
    [Parameter] public DateOnly? Max { get; set; }

    private Task OnChanged(DateTime? date) =>
        ValueChanged.InvokeAsync(date is null ? null : DateOnly.FromDateTime(date.Value));
}
