@* Fields of the "Change password" dialog. *@
<MudTextField @bind-Value="Model.CurrentPassword" For="@(() => Model.CurrentPassword)" Label="@T("Current password")"
              InputType="InputType.Password" Immediate="true" autocomplete="current-password" Class="mb-2" />
<MudTextField @bind-Value="Model.NewPassword" For="@(() => Model.NewPassword)" Label="@T("New password")"
              InputType="@(_show ? InputType.Text : InputType.Password)" Immediate="true" autocomplete="new-password"
              HelperText="@T("At least 8 characters, with upper- and lowercase letters and a digit")"
              Adornment="Adornment.End" AdornmentIcon="@(_show ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
              OnAdornmentClick="@(() => _show = !_show)" AdornmentAriaLabel="@T("Show password")" />
<MudText Typo="Typo.caption" Class="mt-3" Style="display:block">@T("You stay signed in here; other phones and browsers signed in as you are signed out.")</MudText>

@code {
    [Parameter, EditorRequired] public ChangePasswordRequest Model { get; set; } = null!;
    private bool _show;
}
