@* Least-cost ration planner. Runs entirely in the browser / phone, so it also works offline. *@
@using Felcra.Profiling.Analytics.Ration
@using Felcra.Profiling.Contracts.MasterData
@using Felcra.Profiling.Domain.MasterData

<MudGrid Spacing="3">
    <MudItem xs="12" md="@(Compact ? 12 : 5)">
        <MudPaper Class="pa-3" Elevation="@(Compact ? 0 : 1)" Outlined="@Compact">
            <MudText Typo="Typo.subtitle1" Class="mb-2">@T("Animals")</MudText>
            <MudSelect T="string" Label="@T("Animal class")" @bind-Value="_presetKey" @bind-Value:after="ApplyPreset" Dense="true" Class="mb-2">
                @foreach (var preset in RationPresets.All(_bodyWeight))
                {
                    <MudSelectItem Value="@preset.Key">@preset.Name</MudSelectItem>
                }
            </MudSelect>
            <MudStack Row="true" Spacing="2">
                <MudNumericField T="double" Label="@T("Body weight (kg)")" @bind-Value="_bodyWeight" @bind-Value:after="ApplyPreset" Variant="Variant.Text" HideSpinButtons="true" />
                <MudNumericField T="int" Label="@T("Number of animals")" @bind-Value="_headCount" Variant="Variant.Text" HideSpinButtons="true" />
            </MudStack>

            <MudText Typo="Typo.subtitle1" Class="mt-4 mb-1">@T("Daily targets per animal")</MudText>
            <MudText Typo="Typo.caption" Style="display:block" Class="mb-2">
                @T("Filled in from the animal class; change them to suit. Nutrients are % of the ration's dry matter (DM).")
            </MudText>
            <MudGrid Spacing="1">
                <MudItem xs="6"><MudNumericField T="double" Label="@T("DM intake (kg)")" @bind-Value="_dmi" @bind-Value:after="Calculate" HideSpinButtons="true" /></MudItem>
                <MudItem xs="6"><MudNumericField T="double" Label="@T("Crude protein min %")" @bind-Value="_cpMin" @bind-Value:after="Calculate" HideSpinButtons="true" /></MudItem>
                <MudItem xs="6"><MudNumericField T="double?" Label="@T("TDN min %")" @bind-Value="_tdnMin" @bind-Value:after="Calculate" HideSpinButtons="true" /></MudItem>
                <MudItem xs="6"><MudNumericField T="double?" Label="@T("Forage min % of DM")" @bind-Value="_forageMin" @bind-Value:after="Calculate" HideSpinButtons="true" /></MudItem>
                <MudItem xs="6"><MudNumericField T="double?" Label="@T("Calcium min %")" @bind-Value="_caMin" @bind-Value:after="Calculate" HideSpinButtons="true" /></MudItem>
                <MudItem xs="6"><MudNumericField T="double?" Label="@T("Phosphorus min %")" @bind-Value="_pMin" @bind-Value:after="Calculate" HideSpinButtons="true" /></MudItem>
            </MudGrid>

            <MudText Typo="Typo.subtitle1" Class="mt-4 mb-1">@T("Ingredients ({0} of {1})", _selected.Count, Feeds.Count)</MudText>
            @if (Feeds.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">@T("No feed ingredients yet. They are set up under Master data → Feed ingredients.")</MudAlert>
            }
            @foreach (var feed in Feeds)
            {
                var usable = feed.PricePerKg is not null && feed.DryMatterPercent is > 0;
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Style="min-height:44px">
                    <MudCheckBox T="bool" Value="@_selected.Contains(feed.Id)" ValueChanged="@(v => Toggle(feed.Id, v))" Disabled="@(!usable)"
                                 Dense="true" Color="Color.Primary" aria-label="@feed.Name" />
                    <div style="flex:1;min-width:0">
                        <MudText Typo="Typo.body2">@feed.Name</MudText>
                        <MudText Typo="Typo.caption" Style="display:block">
                            @(usable ? $"RM {feed.PricePerKg:0.00}/kg · DM {feed.DryMatterPercent:0.#}% · CP {feed.CrudeProteinPercent:0.#}%" : T("Needs a price and DM % to be used"))
                        </MudText>
                    </div>
                    @if (_selected.Contains(feed.Id))
                    {
                        <MudNumericField T="double?" Value="@_maxInclusion.GetValueOrDefault(feed.Id)" ValueChanged="@(v => SetMax(feed.Id, v))"
                                         Placeholder="@T("max %")" Variant="Variant.Text" HideSpinButtons="true" Margin="Margin.Dense" Style="max-width:72px"
                                         aria-label="@T("{0} maximum % of DM", feed.Name)" />
                    }
                </MudStack>
            }
            <MudText Typo="Typo.caption" Style="display:block" Class="mt-1">@T("\"max %\" limits an ingredient's share of the ration's dry matter (optional).")</MudText>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" md="@(Compact ? 12 : 7)">
        <MudPaper Class="pa-3" Elevation="@(Compact ? 0 : 1)" Outlined="@Compact" data-testid="ration-result">
            <MudText Typo="Typo.subtitle1" Class="mb-2">@T("Least-cost ration")</MudText>
            @if (_result is null)
            {
                <MudText Typo="Typo.body2">@T("Choose ingredients and targets.")</MudText>
            }
            else if (!_result.Feasible)
            {
                <MudAlert Severity="Severity.Warning">@_result.Problem</MudAlert>
            }
            else
            {
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="4" Class="mb-3">
                    <div>
                        <MudText Typo="Typo.caption">@T("Cost per animal per day")</MudText>
                        <MudText Typo="Typo.h5" data-testid="ration-cost">RM @_result.CostPerDay.ToString("0.00")</MudText>
                    </div>
                    @if (_headCount > 1)
                    {
                        <div>
                            <MudText Typo="Typo.caption">@T("{0} animals per day", _headCount)</MudText>
                            <MudText Typo="Typo.h5">RM @((_result.CostPerDay * _headCount).ToString("0.00"))</MudText>
                        </div>
                    }
                    <div>
                        <MudText Typo="Typo.caption">@(_headCount > 1 ? T("{0} animals, 30 days", _headCount) : T("Per animal, 30 days"))</MudText>
                        <MudText Typo="Typo.h5">RM @((_result.CostPerDay * Math.Max(1, _headCount) * 30).ToString("#,0"))</MudText>
                    </div>
                </MudStack>

                <MudSimpleTable Dense="true" Elevation="0" Class="mb-3">
                    <thead>
                        <tr><th>@T("Ingredient")</th><th style="text-align:right">@T("kg as fed / day")</th><th style="text-align:right">@T("% of DM")</th><th style="text-align:right">@T("RM / day")</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var line in _result.Lines)
                        {
                            <tr>
                                <td>@line.Name</td>
                                <td style="text-align:right">@line.AsFedKg.ToString("0.00")@(_headCount > 1 ? " " + T("({0:0.#} total)", line.AsFedKg * _headCount) : "")</td>
                                <td style="text-align:right">@line.PercentOfDryMatter.ToString("0.#")</td>
                                <td style="text-align:right">@line.Cost.ToString("0.00")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>

                <MudText Typo="Typo.subtitle2" Class="mb-1">@T("Nutrients supplied")</MudText>
                <MudSimpleTable Dense="true" Elevation="0">
                    <thead><tr><th>@T("Nutrient")</th><th style="text-align:right">@T("Ration")</th><th style="text-align:right">@T("Target")</th></tr></thead>
                    <tbody>
                        @foreach (var n in _result.Nutrients)
                        {
                            <tr>
                                <td>@n.Nutrient</td>
                                <td style="text-align:right">@n.Achieved.ToString("0.##")</td>
                                <td style="text-align:right">@Range(n)</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
            @if (_result is { Warnings.Count: > 0 })
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-3">
                    @foreach (var w in _result.Warnings) { <div>@w</div> }
                </MudAlert>
            }
            <MudText Typo="Typo.caption" Style="display:block" Class="mt-3">
                @T("Targets are starting guidance for tropical beef cattle and should be confirmed by a nutritionist. Results are only as good as the feed values and prices in Master data.")

            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<FeedIngredientDto> Feeds { get; set; } = [];
    /// <summary>Single-column layout for the phone.</summary>
    [Parameter] public bool Compact { get; set; }

    private string _presetKey = "maintenance";
    private double _bodyWeight = 350;
    private int _headCount = 1;
    private double _dmi, _cpMin;
    private double? _tdnMin, _caMin, _caMax, _pMin, _forageMin;
    private readonly HashSet<Guid> _selected = [];
    private readonly Dictionary<Guid, double?> _maxInclusion = [];
    private IReadOnlyList<FeedIngredientDto>? _loadedFeeds;
    private RationResult? _result;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_loadedFeeds, Feeds)) return;
        _loadedFeeds = Feeds;
        _selected.Clear();
        foreach (var feed in Feeds.Where(f => f.PricePerKg is not null && f.DryMatterPercent is > 0))
            _selected.Add(feed.Id);
        ApplyPreset();
    }

    private void ApplyPreset()
    {
        if (_bodyWeight <= 0) return;
        var preset = RationPresets.All(_bodyWeight).FirstOrDefault(p => p.Key == _presetKey) ?? RationPresets.All(_bodyWeight)[0];
        var t = preset.Targets;
        (_dmi, _cpMin, _tdnMin, _caMin, _caMax, _pMin, _forageMin) =
            (t.DryMatterIntakeKg, t.CrudeProteinMinPercent, t.TdnMinPercent, t.CalciumMinPercent, t.CalciumMaxPercent, t.PhosphorusMinPercent, t.ForageMinPercent);
        Calculate();
    }

    private void Toggle(Guid id, bool on)
    {
        if (on) _selected.Add(id);
        else _selected.Remove(id);
        Calculate();
    }

    private void SetMax(Guid id, double? max)
    {
        _maxInclusion[id] = max is > 0 ? max : null;
        Calculate();
    }

    private void Calculate()
    {
        if (_dmi <= 0 || _selected.Count == 0)
        {
            _result = null;
            return;
        }
        var ingredients = Feeds.Where(f => _selected.Contains(f.Id))
            .Select(f => ToIngredient(f, _maxInclusion.GetValueOrDefault(f.Id)))
            .ToList();
        _result = RationFormulator.Formulate(ingredients,
            new RationTargets(_dmi, _cpMin, null, _tdnMin, null, _caMin, _caMax, _pMin, _forageMin));
    }

    private static RationIngredient ToIngredient(FeedIngredientDto f, double? maxInclusion) => new(
        f.Id, f.Name, f.Category == FeedCategory.Forage,
        (double?)f.DryMatterPercent, (double?)f.CrudeProteinPercent, (double?)f.TdnPercent, (double?)f.MetabolisableEnergy,
        (double?)f.CalciumPercent, (double?)f.PhosphorusPercent, (double?)f.PricePerKg, maxInclusion);

    private static string Range(NutrientLevel n) => (n.Minimum, n.Maximum) switch
    {
        ({ } min, { } max) => $"{min:0.##} – {max:0.##}",
        ({ } min, null) => $"≥ {min:0.##}",
        (null, { } max) => $"≤ {max:0.##}",
        _ => "–",
    };
}
