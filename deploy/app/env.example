# Copy to production.env (or staging.env), fill in, and keep it on the server only (never commit it).
# Generate secrets with:   openssl rand -base64 48

# Stack identity: the proxy site file points at "<STACK_NAME>-app".
STACK_NAME=felcra-production
DOMAIN=profiling.felcra.com.my

# Image built by GitHub Actions (see .github/workflows/release.yml).
APP_IMAGE=ghcr.io/OWNER/felcra-profiling
APP_TAG=latest

POSTGRES_PASSWORD=
JWT_SIGNING_KEY=

# First HQ admin, created only while the database has no users. Change the password after first sign-in.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Staging only: add the Pagoh demo farm and sample manager / officer accounts.
SEED_DEMO_DATA=false

# Monthly report e-mail (needs SMTP).
EMAIL_FROM="FELCRA Cattle Profiling <no-reply@felcra.com.my>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MONTHLY_REPORTS=false

# Task notifications: docker run --rm $APP_IMAGE:$APP_TAG vapid-keys   (keep the same keys afterwards)
PUSH_PUBLIC_KEY=
PUSH_PRIVATE_KEY=
PUSH_SUBJECT=mailto:it@felcra.com.my

# Farm map place search uses OpenStreetMap's Nominatim; a contact address lets its operators reach FELCRA.
GEOCODING_EMAIL=it@felcra.com.my


# Backups (host folder), kept this many days; hour is Malaysia time.
BACKUP_DIR=/srv/felcra/backups/production
BACKUP_KEEP_DAYS=14
BACKUP_HOUR=2
# Off-site copy target for rclone (profile "offsite"), e.g. a remote defined in rclone.conf.
OFFSITE_TARGET=offsite:felcra-backups/production
