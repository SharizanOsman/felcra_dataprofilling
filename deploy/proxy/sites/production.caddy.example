# Copy to production.caddy and set the domain. The upstream name is "<STACK_NAME>-app" from the stack's env file.
ffisblivestock360.com {
	import felcra
	reverse_proxy felcra-production-app:8080
}

# www sends visitors to the main address (needs its own DNS record; Caddy gets a certificate for it too).
www.ffisblivestock360.com {
	redir https://ffisblivestock360.com{uri} permanent
}
